#:kivy 2.0.0

<ChannelControlWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '32dp'
    spacing: '6dp'
    padding: ['4dp', '2dp']

    ToggleButton:
        id: channel_toggle
        text: root.channel_name
        active: root.is_active
        state: 'down' if root.is_active else 'normal'
        size_hint_x: 0.32
        font_size: '11sp'
        bold: True
        background_color: root.btn_bg_color if root.is_active else [root.btn_bg_color[0]*0.35, root.btn_bg_color[1]*0.35, root.btn_bg_color[2]*0.35, 1.0]
        color: (1, 1, 1, 1)
        on_release: app.select_channel(root.channel_name)

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.46
        spacing: '1dp'

        Label:
            text: root.channel_spec_info
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.85, 0.85, 0.85, 1)

        Label:
            text: "Ref: " + root.ref_image_path
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.6, 0.7, 0.8, 1)

    Button:
        text: "Ref"
        size_hint_x: 0.22
        font_size: '10sp'
        on_release: root.open_ref_chooser()


<ZoomPanCameraWidget>:
    # ZoomPanCameraWidget canvas is handled dynamically in Python
    Widget:


<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: '8dp'
    spacing: '8dp'

    # Top Header Bar: Title, Active Well Display, Stage Coordinates, Calibration Status
    BoxLayout:
        size_hint_y: None
        height: '40dp'
        spacing: '8dp'
        padding: '4dp'
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.20, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Automation"
            font_size: '15sp'
            bold: True
            size_hint_x: 0.32
            padding_x: '8dp'
            color: (1, 1, 1, 1)

        Label:
            text: "Active Well: " + root.current_well_display
            font_size: '13sp'
            bold: True
            size_hint_x: 0.18
            color: (0.3, 0.8, 1.0, 1)

        Label:
            text: root.stage_coord_str
            size_hint_x: 0.30
            font_size: '11sp'
            bold: True
            color: (0.4, 0.8, 1.0, 1)

        Label:
            text: root.calibrated_status
            size_hint_x: 0.20
            font_size: '11sp'
            bold: True
            color: (0.2, 0.9, 0.4, 1) if "Calibrated" in root.calibrated_status else (0.9, 0.3, 0.3, 1)

    # Main Single-Window Workspace: 2 Side-by-Side Columns (50% / 50%)
    BoxLayout:
        orientation: 'horizontal'
        spacing: '10dp'

        # LEFT COLUMN (50% Width): Top-Left Camera Viewport + Bottom-Left Hardware Controls Deck
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # Top-Left: Live Camera Viewport (Zoom / Pan / Red Reticle Crosshairs)
            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_y: 0.55

            # Bottom-Left: Hardware Motion & Illumination Control Deck
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.45
                spacing: '4dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: 0.10, 0.11, 0.14, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Microscope Motion & Illumination Deck"
                    font_size: '12sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: (0.3, 0.8, 1.0, 1)

                # Row 1: Camera Setup & Illumination
                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '6dp'

                    ToggleButton:
                        text: "Light: ON" if app.is_light_on else "Light: OFF"
                        state: 'down' if app.is_light_on else 'normal'
                        size_hint_x: 0.28
                        bold: True
                        font_size: '10sp'
                        background_color: (0.2, 0.8, 0.3, 1) if app.is_light_on else (0.6, 0.3, 0.3, 1)
                        on_release: app.toggle_light_state()

                    Label:
                        text: "Exp (ms):"
                        font_size: '9sp'
                        size_hint_x: 0.14

                    TextInput:
                        text: "20.0"
                        multiline: False
                        size_hint_x: 0.16
                        font_size: '9sp'
                        on_text_validate: app.set_exposure_ms(self.text)

                    Label:
                        text: "Gain:"
                        font_size: '9sp'
                        size_hint_x: 0.10

                    TextInput:
                        text: "1.0"
                        multiline: False
                        size_hint_x: 0.14
                        font_size: '9sp'
                        on_text_validate: app.set_gain_val(self.text)

                    Label:
                        text: "LED %:"
                        font_size: '9sp'
                        size_hint_x: 0.10

                    TextInput:
                        text: "100"
                        multiline: False
                        size_hint_x: 0.12
                        font_size: '9sp'
                        on_text_validate: app.set_led_power(self.text)

                # Row 2: Grouped Motion Jogging Deck (XY Cross + Z Focus Column)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '105dp'
                    spacing: '8dp'

                    # Grouped XY Cross (Direction Pairs: ++Y/+Y, --Y/-Y, --X/-X, ++X/+X)
                    GridLayout:
                        cols: 3
                        spacing: '3dp'
                        size_hint_x: 0.72

                        # Top (+Y Direction Pair)
                        Widget:
                        BoxLayout:
                            spacing: '2dp'
                            Button:
                                text: "++Y"
                                font_size: '8sp'
                                bold: True
                                on_release: app.jog_stage(0, 5.0, 0)
                            Button:
                                text: "+Y"
                                font_size: '9sp'
                                bold: True
                                on_release: app.jog_stage(0, 0.5, 0)
                        Widget:

                        # Left (-X Direction Pair)
                        BoxLayout:
                            spacing: '2dp'
                            Button:
                                text: "--X"
                                font_size: '8sp'
                                bold: True
                                on_release: app.jog_stage(-5.0, 0, 0)
                            Button:
                                text: "-X"
                                font_size: '9sp'
                                bold: True
                                on_release: app.jog_stage(-0.5, 0, 0)

                        # Center Home Button
                        Button:
                            text: "A1"
                            font_size: '9sp'
                            bold: True
                            background_color: (0.2, 0.5, 0.8, 1)
                            on_release: app.jog_stage_to(-49.5, 31.5)

                        # Right (+X Direction Pair)
                        BoxLayout:
                            spacing: '2dp'
                            Button:
                                text: "+X"
                                font_size: '9sp'
                                bold: True
                                on_release: app.jog_stage(0.5, 0, 0)
                            Button:
                                text: "++X"
                                font_size: '8sp'
                                bold: True
                                on_release: app.jog_stage(5.0, 0, 0)

                        # Bottom (-Y Direction Pair)
                        Widget:
                        BoxLayout:
                            spacing: '2dp'
                            Button:
                                text: "-Y"
                                font_size: '9sp'
                                bold: True
                                on_release: app.jog_stage(0, -0.5, 0)
                            Button:
                                text: "--Y"
                                font_size: '8sp'
                                bold: True
                                on_release: app.jog_stage(0, -5.0, 0)
                        Widget:

                    # Z Focus Vertical Column (4 Buttons: ++Z, +Z, -Z, --Z)
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 0.28
                        spacing: '2dp'

                        Label:
                            text: "Z Focus"
                            font_size: '9sp'
                            bold: True
                            color: (0.3, 0.8, 1.0, 1)
                            size_hint_y: None
                            height: '14dp'

                        Button:
                            text: "++Z (+100u)"
                            font_size: '8sp'
                            on_release: app.jog_z_focus(100.0)
                        Button:
                            text: "+Z (+10u)"
                            font_size: '8sp'
                            on_release: app.jog_z_focus(10.0)
                        Button:
                            text: "-Z (-10u)"
                            font_size: '8sp'
                            on_release: app.jog_z_focus(-10.0)
                        Button:
                            text: "--Z (-100u)"
                            font_size: '8sp'
                            on_release: app.jog_z_focus(-100.0)

                # Row 3: Objective Lens Preset Spinner & Capture Snapshot
                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '8dp'

                    Label:
                        text: "Objective:"
                        font_size: '10sp'
                        bold: True
                        size_hint_x: 0.25

                    Spinner:
                        id: main_objective_spinner
                        text: "20x Air"
                        values: ["1.25x", "4x", "5x", "10x", "20x Air", "20x", "40x", "60x Oil", "63x", "100x Oil"]
                        size_hint_x: 0.40
                        font_size: '10sp'
                        on_text: app.set_objective_preset(self.text)

                    Button:
                        text: "Capture Snapshot"
                        size_hint_x: 0.35
                        background_color: (0.2, 0.6, 0.8, 1)
                        font_size: '10sp'
                        bold: True
                        on_release: app.capture_snapshot()

        # RIGHT COLUMN (50% Width): Top-Right Microplate Map Display + Bottom-Right Registration Studio
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # Top-Right: Microplate Display & Well Format Selector
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.55
                spacing: '4dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.12, 0.14, 0.18, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                # Well Plate Format Selector Header Bar
                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '6dp'

                    Label:
                        text: "Labware Plate Format:"
                        font_size: '11sp'
                        bold: True
                        size_hint_x: 0.45
                        color: (0.3, 0.8, 1.0, 1)

                    Spinner:
                        id: plate_format_spinner
                        text: "96-Well Plate"
                        values: ["6-Well Plate", "12-Well Plate", "24-Well Plate", "48-Well Plate", "96-Well Plate", "384-Well Plate"]
                        font_size: '11sp'
                        bold: True
                        size_hint_x: 0.55
                        on_text: app.set_well_plate_format(self.text)

                # Top-Right Interactive Well Plate Map Display
                InteractiveScaledPlateCanvas:
                    id: main_plate_canvas

                Label:
                    text: "Double-click map to move stage directly | Arrow keys = XY | PageUp/Down = Z"
                    font_size: '9sp'
                    size_hint_y: None
                    height: '16dp'
                    color: (0.7, 0.8, 0.9, 1)

            # Bottom-Right: Microplate Registration Studio & Channels
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.45
                spacing: '6dp'

                # Left Sub-Box: Optical Channels Selection (Mutual Exclusion)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.45
                    spacing: '4dp'
                    padding: '4dp'
                    canvas.before:
                        Color:
                            rgba: 0.10, 0.11, 0.14, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    Label:
                        text: "Optical Channels"
                        font_size: '11sp'
                        bold: True
                        size_hint_y: None
                        height: '18dp'
                        color: (0.3, 0.8, 1.0, 1)

                    ScrollView:
                        BoxLayout:
                            id: main_channel_container
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: '3dp'

                # Right Sub-Box: Embedded Studio Tabs (6-Point Calibration Wizard)
                TabbedPanel:
                    id: main_tabbed_panel
                    do_default_tab: False
                    tab_width: '100dp'
                    size_hint_x: 0.55

                    # TAB 1: 6-Point Calibration Target Registration Wizard
                    TabbedPanelItem:
                        text: '1. Calib'
                        BoxLayout:
                            orientation: 'vertical'
                            padding: '4dp'
                            spacing: '4dp'

                            Label:
                                id: wizard_instruction_label
                                text: root.calibration_wizard_text if hasattr(root, 'calibration_wizard_text') else "Click 'Start Calib' to begin"
                                size_hint_y: None
                                height: '28dp'
                                color: (0.9, 0.9, 0.2, 1)
                                bold: True
                                font_size: '9sp'
                                halign: 'center'
                                valign: 'middle'
                                text_size: self.size

                            GridLayout:
                                cols: 2
                                spacing: '4dp'
                                size_hint_y: None
                                height: '56dp'

                                Button:
                                    text: "Start Calib"
                                    background_color: (0.2, 0.6, 0.8, 1)
                                    bold: True
                                    font_size: '9sp'
                                    on_release: app.start_calibration_wizard()

                                Button:
                                    text: "Mark Target"
                                    background_color: (0.2, 0.7, 0.3, 1)
                                    bold: True
                                    font_size: '9sp'
                                    on_release: app.mark_calibration_step()

                                Button:
                                    text: "< Prev"
                                    font_size: '9sp'
                                    on_release: app.previous_calibration_step()

                                Button:
                                    text: "Next >"
                                    font_size: '9sp'
                                    on_release: app.next_calibration_step()

                            BoxLayout:
                                size_hint_y: None
                                height: '26dp'
                                spacing: '4dp'

                                Button:
                                    text: "Done"
                                    background_color: (0.8, 0.4, 0.2, 1)
                                    bold: True
                                    font_size: '9sp'
                                    on_release: app.finish_plate_calibration()

                                Button:
                                    text: "Reset"
                                    font_size: '9sp'
                                    on_release: app.reset_calibration()

                    # TAB 2: Autofocus & Schedule
                    TabbedPanelItem:
                        text: '2. AF'
                        BoxLayout:
                            orientation: 'vertical'
                            padding: '4dp'
                            spacing: '4dp'

                            BoxLayout:
                                size_hint_y: None
                                height: '24dp'
                                spacing: '4dp'

                                Label:
                                    text: "AF Channel:"
                                    font_size: '9sp'
                                Spinner:
                                    id: af_channel_spinner
                                    text: "Brightfield"
                                    values: ["Brightfield", "Phase", "Darkfield", "Blue", "Green", "Red"]
                                    font_size: '9sp'
                                    on_text: app.set_primary_af_channel(self.text)

                            Button:
                                text: "Set Master Auto (Red)"
                                background_color: (0.8, 0.2, 0.2, 1)
                                bold: True
                                font_size: '9sp'
                                on_release: app.set_master_auto_point()

                            Button:
                                text: "Test Autofocus"
                                background_color: (0.2, 0.6, 0.8, 1)
                                bold: True
                                font_size: '9sp'
                                on_release: app.test_autofocus_run()

                    # TAB 3: Protocol Generator
                    TabbedPanelItem:
                        text: '3. Protocol'
                        BoxLayout:
                            orientation: 'vertical'
                            padding: '4dp'
                            spacing: '4dp'

                            Button:
                                text: "Compile Protocol JSON"
                                size_hint_y: None
                                height: '32dp'
                                background_color: (0.2, 0.7, 0.4, 1)
                                bold: True
                                font_size: '9sp'
                                on_release: app.generate_and_apply_protocol()

    # Footer Status Bar
    BoxLayout:
        size_hint_y: None
        height: '24dp'
        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.status_msg
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            padding_x: '8dp'
            color: (0.7, 0.7, 0.7, 1)
            font_size: '10sp'
