#:kivy 2.0.0

<ChannelControlWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '38dp'
    spacing: '8dp'
    padding: ['4dp', '2dp']

    ToggleButton:
        id: channel_toggle
        text: root.channel_name
        active: root.is_active
        state: 'down' if root.is_active else 'normal'
        size_hint_x: 0.28
        bold: True
        background_color: (0.9, 0.9, 0.9, 1) if root.channel_name == 'Brightfield' else ((0.65, 0.7, 0.75, 1) if root.channel_name == 'Phase' else ((0.4, 0.4, 0.45, 1) if root.channel_name == 'Darkfield' else ((0.0, 0.45, 1.0, 1) if root.channel_name == 'Blue' else ((0.0, 0.85, 0.25, 1) if root.channel_name == 'Green' else (0.95, 0.15, 0.15, 1)))))
        on_state: app.set_active_channel(root.channel_name, self.state == 'down')

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.48

        Label:
            text: root.ref_image_path
            font_size: '11sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.9, 0.9, 0.9, 1)

        Label:
            text: root.channel_spec_info
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.6, 0.7, 0.8, 1)

    Button:
        text: "Load Ref"
        size_hint_x: 0.24
        font_size: '11sp'
        on_release: root.open_ref_chooser()


<ZoomPanCameraWidget>:
    orientation: 'vertical'
    padding: '2dp'
    spacing: '2dp'
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.03, 1
        Rectangle:
            pos: self.pos
            size: self.size

    RelativeLayout:
        id: image_container
        Image:
            id: camera_image
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    BoxLayout:
        size_hint_y: None
        height: '22dp'
        spacing: '6dp'
        padding: ['4dp', '1dp']

        Label:
            text: "Scroll = Zoom (" + str(round(root.zoom_level, 1)) + "x) | Right-Click Drag = Pan"
            font_size: '10sp'
            color: (0.7, 0.7, 0.7, 1)

        Button:
            text: "Reset View"
            size_hint_x: None
            width: '75dp'
            font_size: '10sp'
            on_release: root.reset_zoom_pan()


<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: '10dp'
    spacing: '10dp'

    # Header Bar
    BoxLayout:
        size_hint_y: None
        height: '42dp'
        spacing: '10dp'
        padding: '4dp'
        canvas.before:
            Color:
                rgba: 0.15, 0.15, 0.2, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Automation"
            font_size: '16sp'
            bold: True
            size_hint_x: 0.32
            padding_x: '8dp'

        Label:
            text: "Active Well: " + root.current_well_display
            font_size: '13sp'
            bold: True
            size_hint_x: 0.18
            color: (0.3, 0.8, 1.0, 1)

        Label:
            text: root.stage_coord_str
            size_hint_x: 0.32
            font_size: '11sp'
            color: (0.4, 0.8, 1.0, 1)
            halign: 'right'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.calibrated_status
            size_hint_x: 0.18
            font_size: '11sp'
            bold: True
            color: (0.2, 0.8, 0.4, 1) if "Calibrated" in root.calibrated_status else (0.9, 0.3, 0.3, 1)

    # Main Application Window Layout
    BoxLayout:
        orientation: 'horizontal'
        spacing: '12dp'

        # Left Column: Camera Viewport & Hardware Control Dock
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.62
            spacing: '8dp'

            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_y: 0.65

            # Camera Hardware & Motion Control Deck
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.35
                spacing: '6dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: 0.12, 0.12, 0.15, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                # Live Streaming & Illumination Light Toggle
                BoxLayout:
                    size_hint_y: None
                    height: '28dp'
                    spacing: '8dp'

                    ToggleButton:
                        text: "Live Feed: ON" if root.is_live_imaging else "Live Feed: OFF"
                        state: 'down' if root.is_live_imaging else 'normal'
                        size_hint_x: 0.35
                        font_size: '11sp'
                        bold: True
                        background_color: (0.2, 0.7, 0.3, 1) if root.is_live_imaging else (0.7, 0.3, 0.3, 1)
                        on_release: app.toggle_live_feed()

                    ToggleButton:
                        text: "Light: ON" if root.is_light_on else "Light: OFF (Dark)"
                        state: 'down' if root.is_light_on else 'normal'
                        size_hint_x: 0.35
                        font_size: '11sp'
                        bold: True
                        background_color: (0.9, 0.6, 0.1, 1) if root.is_light_on else (0.3, 0.3, 0.35, 1)
                        on_release: app.toggle_light_state()

                    Label:
                        text: "Refresh:"
                        size_hint_x: 0.15
                        font_size: '11sp'

                    Spinner:
                        text: root.live_fps_str
                        values: ["5 FPS", "10 FPS", "15 FPS", "20 FPS", "30 FPS"]
                        size_hint_x: 0.15
                        font_size: '11sp'
                        on_text: app.set_live_fps(self.text)

                # Camera Exposure, Gain & LED Power
                BoxLayout:
                    size_hint_y: None
                    height: '28dp'
                    spacing: '6dp'

                    Label:
                        text: "Exp (ms):"
                        size_hint_x: 0.15
                        font_size: '10sp'

                    TextInput:
                        text: root.exposure_str
                        multiline: False
                        size_hint_x: 0.18
                        font_size: '10sp'
                        on_text_validate: app.set_exposure_ms(self.text)

                    Label:
                        text: "Gain:"
                        size_hint_x: 0.12
                        font_size: '10sp'

                    TextInput:
                        text: root.gain_str
                        multiline: False
                        size_hint_x: 0.15
                        font_size: '10sp'
                        on_text_validate: app.set_gain_val(self.text)

                    Label:
                        text: "LED Power (%):"
                        size_hint_x: 0.22
                        font_size: '10sp'

                    TextInput:
                        text: root.led_power_str
                        multiline: False
                        size_hint_x: 0.18
                        font_size: '10sp'
                        on_text_validate: app.set_led_power(self.text)

                # Stage XY Motion & Z Focus Controls
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '65dp'
                    spacing: '8dp'

                    GridLayout:
                        cols: 3
                        spacing: '3dp'
                        size_hint_x: 0.45

                        Widget:
                        Button:
                            text: "+Y"
                            font_size: '10sp'
                            on_release: app.jog_stage(0, 1.0, 0)
                        Widget:

                        Button:
                            text: "-X"
                            font_size: '10sp'
                            on_release: app.jog_stage(-1.0, 0, 0)
                        Button:
                            text: "Center A1"
                            font_size: '8sp'
                            on_release: app.zero_stage()
                        Button:
                            text: "+X"
                            font_size: '10sp'
                            on_release: app.jog_stage(1.0, 0, 0)

                        Widget:
                        Button:
                            text: "-Y"
                            font_size: '10sp'
                            on_release: app.jog_stage(0, -1.0, 0)
                        Widget:

                    # Z Focus Fine Controls
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 0.3
                        spacing: '2dp'

                        Label:
                            text: "Z Focus Motor"
                            font_size: '10sp'
                            bold: True

                        GridLayout:
                            cols: 2
                            spacing: '2dp'

                            Button:
                                text: "+10 um"
                                font_size: '9sp'
                                on_release: app.jog_z_microns(10.0)
                            Button:
                                text: "-10 um"
                                font_size: '9sp'
                                on_release: app.jog_z_microns(-10.0)
                            Button:
                                text: "+1 um"
                                font_size: '9sp'
                                on_release: app.jog_z_microns(1.0)
                            Button:
                                text: "-1 um"
                                font_size: '9sp'
                                on_release: app.jog_z_microns(-1.0)

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 0.25
                        spacing: '4dp'

                        Label:
                            text: "Jog Step (mm):"
                            font_size: '10sp'

                        Spinner:
                            text: "1.0 mm"
                            values: ["0.01 mm", "0.1 mm", "1.0 mm", "5.0 mm", "10.0 mm"]
                            font_size: '10sp'
                            on_text: app.set_jog_step_size(self.text)

                # Objective Lens Preset & Capture Snapshot
                BoxLayout:
                    size_hint_y: None
                    height: '28dp'
                    spacing: '10dp'

                    Spinner:
                        text: "20x Air"
                        values: ["4x", "10x", "20x Air", "40x", "60x Oil", "100x Oil"]
                        size_hint_x: 0.5
                        font_size: '11sp'
                        on_text: app.set_objective_preset(self.text)

                    Button:
                        text: "Capture Snapshot PNG"
                        size_hint_x: 0.5
                        background_color: (0.2, 0.5, 0.8, 1)
                        bold: True
                        font_size: '11sp'
                        on_release: app.capture_snapshot()

        # Right Column: Protocol Controls Region & Optical Channels
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.38
            spacing: '10dp'

            # Protocol Region Panel
            BoxLayout:
                orientation: 'vertical'
                spacing: '6dp'
                padding: '8dp'
                size_hint_y: None
                height: '115dp'
                canvas.before:
                    Color:
                        rgba: 0.14, 0.16, 0.22, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Protocol Controls & Experiment Engine"
                    font_size: '13sp'
                    bold: True
                    color: (0.3, 0.8, 1.0, 1)
                    size_hint_y: None
                    height: '20dp'

                Label:
                    text: "Select protocols, multi-well scanning routines & automated execution."
                    font_size: '10sp'
                    color: (0.7, 0.7, 0.7, 1)
                    size_hint_y: None
                    height: '18dp'

                Button:
                    text: "[ Launch Plate Module ]"
                    size_hint_y: None
                    height: '38dp'
                    background_color: (0.2, 0.7, 0.4, 1)
                    bold: True
                    font_size: '13sp'
                    on_release: app.open_plate_navigator()

            # Optical Channels Panel
            BoxLayout:
                orientation: 'vertical'
                spacing: '6dp'

                Label:
                    text: "Optical Imaging Channels"
                    font_size: '14sp'
                    bold: True
                    size_hint_y: None
                    height: '24dp'

                ScrollView:
                    BoxLayout:
                        id: main_channel_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '5dp'

    # Bottom Status Bar
    BoxLayout:
        size_hint_y: None
        height: '28dp'
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.status_msg
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            padding_x: '10dp'
            color: (0.7, 0.7, 0.7, 1)
