#:kivy 2.0.0

<ChannelControlWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '32dp'
    spacing: '6dp'
    padding: ['4dp', '2dp']

    ToggleButton:
        id: channel_toggle
        text: root.channel_name
        active: root.is_active
        state: 'down' if root.is_active else 'normal'
        size_hint_x: 0.32
        font_size: '11sp'
        bold: True
        background_normal: ''
        background_down: ''
        background_color: root.btn_bg_color if root.is_active else [root.btn_bg_color[0]*0.35, root.btn_bg_color[1]*0.35, root.btn_bg_color[2]*0.35, 1.0]
        color: (1, 1, 1, 1)
        on_release: app.select_channel(root.channel_name)

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.46
        spacing: '1dp'

        Label:
            text: root.channel_spec_info
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.85, 0.85, 0.85, 1)

        Label:
            text: "Ref: " + root.ref_image_path
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.6, 0.7, 0.8, 1)

    Button:
        text: "Ref"
        size_hint_x: 0.22
        font_size: '10sp'
        on_release: root.open_ref_chooser()


<ZoomPanCameraWidget>:
    # ZoomPanCameraWidget canvas is handled dynamically in Python
    Widget:


<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: '8dp'
    spacing: '8dp'

    # Top Navigation Header Bar: Stage Coordinates & Calibration Status
    BoxLayout:
        size_hint_y: None
        height: '42dp'
        spacing: '10dp'
        padding: '6dp'
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.20, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Automation"
            font_size: '15sp'
            bold: True
            size_hint_x: 0.35
            color: (1, 1, 1, 1)

        Label:
            text: "Well: " + root.current_well_display
            font_size: '12sp'
            bold: True
            size_hint_x: 0.18
            color: (0.3, 0.8, 1.0, 1)

        Label:
            text: root.stage_coord_str
            size_hint_x: 0.27
            font_size: '11sp'
            bold: True
            color: (0.4, 0.8, 1.0, 1)

        Label:
            text: root.calibrated_status
            size_hint_x: 0.20
            font_size: '11sp'
            bold: True
            color: (0.2, 0.9, 0.4, 1) if "Calibrated" in root.calibrated_status else (0.9, 0.3, 0.3, 1)

    # Main Single-Window Workspace: 2 Equal Columns (50% / 50%)
    BoxLayout:
        orientation: 'horizontal'
        spacing: '10dp'

        # LEFT COLUMN (50%): Top-Left Camera Viewport + Bottom-Left Hardware Deck
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # Embedded Live Camera Feed Viewport (Top-Left)
            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_y: 0.58

            # Hardware Control Deck Panel (Bottom-Left)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.42
                spacing: '4dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: 0.10, 0.11, 0.14, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Hardware Motion, Light & Camera Deck"
                    font_size: '11sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: (0.3, 0.8, 1.0, 1)

                GridLayout:
                    cols: 3
                    spacing: '6dp'

                    # Camera Setup & Illumination
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '3dp'
                        padding: '4dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Camera & Light"
                            bold: True
                            font_size: '10sp'

                        ToggleButton:
                            text: "Light: ON" if app.is_light_on else "Light: OFF"
                            state: 'down' if app.is_light_on else 'normal'
                            background_color: (0.2, 0.8, 0.3, 1) if app.is_light_on else (0.8, 0.2, 0.2, 1)
                            font_size: '10sp'
                            bold: True
                            on_release: app.toggle_light_state()

                        BoxLayout:
                            Label:
                                text: "Exp (ms):"
                                font_size: '9sp'
                            TextInput:
                                text: "20.0"
                                multiline: False
                                font_size: '9sp'
                                on_text_validate: app.set_exposure_ms(self.text)

                        BoxLayout:
                            Label:
                                text: "LED %:"
                                font_size: '9sp'
                            TextInput:
                                text: "100"
                                multiline: False
                                font_size: '9sp'
                                on_text_validate: app.set_led_power(self.text)

                    # Stage Motion XY Controls
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '3dp'
                        padding: '4dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        BoxLayout:
                            Label:
                                text: "XY Step:"
                                font_size: '9sp'
                                bold: True
                            Spinner:
                                text: "1.0 mm"
                                values: ["0.1 mm", "0.5 mm", "1.0 mm", "5.0 mm", "10.0 mm"]
                                font_size: '9sp'
                                on_text: app.set_jog_step(self.text)

                        GridLayout:
                            cols: 3
                            spacing: '2dp'

                            Widget:
                            Button:
                                text: "+Y"
                                font_size: '9sp'
                                on_release: app.jog_stage(0, 1.0, 0)
                            Widget:
                            Button:
                                text: "-X"
                                font_size: '9sp'
                                on_release: app.jog_stage(-1.0, 0, 0)
                            Button:
                                text: "A1"
                                font_size: '9sp'
                                bold: True
                                background_color: (0.2, 0.6, 0.8, 1)
                                on_release: app.zero_stage()
                            Button:
                                text: "+X"
                                font_size: '9sp'
                                on_release: app.jog_stage(1.0, 0, 0)
                            Widget:
                            Button:
                                text: "-Y"
                                font_size: '9sp'
                                on_release: app.jog_stage(0, -1.0, 0)
                            Widget:

                    # Z Focus Controls & Objective
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '3dp'
                        padding: '4dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Z Focus & Lens"
                            bold: True
                            font_size: '10sp'

                        GridLayout:
                            cols: 2
                            spacing: '2dp'

                            Button:
                                text: "+10u"
                                font_size: '8sp'
                                on_release: app.jog_z(10.0)
                            Button:
                                text: "+1u"
                                font_size: '8sp'
                                on_release: app.jog_z(1.0)
                            Button:
                                text: "-1u"
                                font_size: '8sp'
                                on_release: app.jog_z(-1.0)
                            Button:
                                text: "-10u"
                                font_size: '8sp'
                                on_release: app.jog_z(-10.0)

                        Button:
                            text: "Capture Snapshot"
                            background_color: (0.2, 0.6, 0.8, 1)
                            font_size: '9sp'
                            bold: True
                            on_release: app.capture_snapshot()

        # RIGHT COLUMN (50%): Top-Right Microplate Map Display + Bottom-Right Channels & Studio
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # Top-Right: Microplate Display & Well Format Selector
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.55
                spacing: '4dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.12, 0.14, 0.18, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                # Well Plate Format & Objective Selector Header Bar
                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '6dp'

                    Label:
                        text: "Format:"
                        bold: True
                        font_size: '10sp'
                        size_hint_x: 0.2
                        color: (0.3, 0.8, 1.0, 1)

                    Spinner:
                        id: plate_format_spinner
                        text: "96-Well Plate"
                        values: ["6-Well Plate", "12-Well Plate", "24-Well Plate", "48-Well Plate", "96-Well Plate", "384-Well Plate"]
                        font_size: '10sp'
                        bold: True
                        size_hint_x: 0.35
                        on_text: app.set_well_plate_format(self.text)

                    Label:
                        text: "Lens:"
                        bold: True
                        font_size: '10sp'
                        size_hint_x: 0.15
                        color: (0.3, 0.8, 1.0, 1)

                    Spinner:
                        id: main_objective_spinner
                        text: "20x Air"
                        values: ["1.25x", "4x", "5x", "10x", "20x Air", "20x", "40x", "60x Oil", "63x", "100x Oil"]
                        font_size: '10sp'
                        size_hint_x: 0.30
                        on_text: app.set_objective_preset(self.text)

                # Top-Right Interactive Well Plate Map Display
                InteractiveScaledPlateCanvas:
                    id: main_plate_canvas

            # Bottom-Right: Optical Channels & Registration Studio
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.45
                spacing: '4dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.10, 0.11, 0.14, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Optical Channels (Single-Channel Mutual Exclusion)"
                    font_size: '11sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: (0.3, 0.8, 1.0, 1)

                ScrollView:
                    size_hint_y: 0.55
                    BoxLayout:
                        id: main_channel_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '3dp'

                # Calibration Wizard Action Controls
                BoxLayout:
                    size_hint_y: 0.45
                    spacing: '4dp'

                    Button:
                        text: "Start Calib"
                        font_size: '9sp'
                        bold: True
                        background_color: (0.2, 0.6, 0.8, 1)
                        on_release: app.start_calibration_wizard()

                    Button:
                        text: "Mark Target"
                        font_size: '9sp'
                        bold: True
                        background_color: (0.2, 0.7, 0.3, 1)
                        on_release: app.mark_calibration_step()

                    Button:
                        text: "< Prev"
                        font_size: '9sp'
                        on_release: app.previous_calibration_step()

                    Button:
                        text: "Next >"
                        font_size: '9sp'
                        on_release: app.next_calibration_step()

                    Button:
                        text: "Done"
                        font_size: '9sp'
                        bold: True
                        background_color: (0.8, 0.4, 0.2, 1)
                        on_release: app.finish_plate_calibration()

                    Button:
                        text: "Reset"
                        font_size: '9sp'
                        on_release: app.reset_calibration()

    # Footer Status Bar
    BoxLayout:
        size_hint_y: None
        height: '24dp'
        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.status_msg
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            padding_x: '8dp'
            color: (0.7, 0.7, 0.7, 1)
            font_size: '10sp'
