#:kivy 2.0.0

<ChannelControlWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '34dp'
    spacing: '6dp'

    ToggleButton:
        id: channel_toggle
        text: root.channel_name
        active: root.is_active
        state: 'down' if root.is_active else 'normal'
        size_hint_x: 0.35
        font_size: '11sp'
        bold: True
        background_normal: ''
        background_down: ''
        background_color: root.btn_bg_color if root.is_active else [root.btn_bg_color[0]*0.35, root.btn_bg_color[1]*0.35, root.btn_bg_color[2]*0.35, 1.0]
        on_release: app.select_channel(root.channel_name)

    Label:
        text: root.channel_spec_info
        size_hint_x: 0.45
        font_size: '9sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        color: (0.8, 0.8, 0.8, 1)

    Button:
        text: "Ref"
        size_hint_x: 0.20
        font_size: '10sp'
        on_release: root.open_ref_chooser()


<ZoomPanCameraWidget>:
    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size


<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: '8dp'
    spacing: '8dp'

    # Top Header Bar: Title, Well Indicator, Stage Coords, Calibration Status
    BoxLayout:
        size_hint_y: None
        height: '42dp'
        spacing: '10dp'
        padding: '6dp'
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.20, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Automation"
            font_size: '15sp'
            bold: True
            size_hint_x: 0.32
            color: (1, 1, 1, 1)

        Label:
            text: "Well: " + root.current_well_display
            font_size: '12sp'
            bold: True
            size_hint_x: 0.15
            color: (0.3, 0.8, 1.0, 1)

        Label:
            text: root.stage_coord_str
            size_hint_x: 0.33
            font_size: '11sp'
            bold: True
            color: (0.4, 0.8, 1.0, 1)

        Label:
            text: root.calibrated_status
            size_hint_x: 0.20
            font_size: '11sp'
            bold: True
            color: (0.2, 0.9, 0.4, 1) if "Calibrated" in root.calibrated_status else (0.9, 0.3, 0.3, 1)

    # Main Single-Window UI Body: Left & Right Columns
    BoxLayout:
        orientation: 'horizontal'
        spacing: '10dp'

        # LEFT COLUMN (Width: 48%): Live Viewport & Hardware Controls Deck
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.48
            spacing: '8dp'

            # Live Camera Feed Viewport (With Reticle Crosshair & Double-Click Centering)
            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_y: 0.58

            # Hardware Control Deck
            ScrollView:
                size_hint_y: 0.42
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '6dp'
                    padding: '6dp'
                    canvas.before:
                        Color:
                            rgba: 0.10, 0.11, 0.14, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    Label:
                        text: "Hardware & Illumination Controls"
                        font_size: '12sp'
                        bold: True
                        size_hint_y: None
                        height: '20dp'
                        color: (0.3, 0.8, 1.0, 1)

                    # Camera Settings & Illumination Toggle
                    GridLayout:
                        cols: 2
                        spacing: '6dp'
                        size_hint_y: None
                        height: '80dp'

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: '2dp'

                            BoxLayout:
                                Label:
                                    text: "Exp (ms):"
                                    font_size: '10sp'
                                TextInput:
                                    text: str(app.camera_exposure_ms)
                                    multiline: False
                                    font_size: '10sp'
                                    on_text_validate: app.set_af_exposure(self.text)

                            BoxLayout:
                                Label:
                                    text: "Gain:"
                                    font_size: '10sp'
                                TextInput:
                                    text: str(app.camera_gain)
                                    multiline: False
                                    font_size: '10sp'

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: '2dp'

                            ToggleButton:
                                text: "Light: ON" if app.is_light_on else "Light: OFF"
                                state: 'down' if app.is_light_on else 'normal'
                                font_size: '11sp'
                                bold: True
                                background_color: (0.2, 0.8, 0.4, 1) if app.is_light_on else (0.4, 0.4, 0.4, 1)
                                on_release: app.toggle_light_state()

                            BoxLayout:
                                Label:
                                    text: "LED Power (%):"
                                    font_size: '10sp'
                                TextInput:
                                    text: str(app.led_power)
                                    multiline: False
                                    font_size: '10sp'
                                    on_text_validate: app.set_led_power(self.text)

                    # Coarse & Fine Stage Motion Deck
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '4dp'
                        size_hint_y: None
                        height: '115dp'
                        padding: '4dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "XY Stage & Z Focus Jogging (Coarse / Fine)"
                            font_size: '11sp'
                            bold: True
                            color: (0.3, 0.8, 1.0, 1)

                        # XY Stage Controls (Coarse ++ and Fine +)
                        GridLayout:
                            cols: 5
                            spacing: '2dp'
                            size_hint_y: None
                            height: '52dp'

                            Widget:
                            Button:
                                text: "++Y (5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(0, 5.0, 0)
                            Button:
                                text: "+Y (0.5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(0, 0.5, 0)
                            Widget:
                            Widget:

                            Button:
                                text: "--X (5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(-5.0, 0, 0)
                            Button:
                                text: "-X (0.5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(-0.5, 0, 0)
                            Button:
                                text: "0 (A1)"
                                font_size: '9sp'
                                bold: True
                                on_release: app.jog_stage_to(-49.5, 31.5)
                            Button:
                                text: "+X (0.5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(0.5, 0, 0)
                            Button:
                                text: "++X (5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(5.0, 0, 0)

                            Widget:
                            Button:
                                text: "--Y (5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(0, -5.0, 0)
                            Button:
                                text: "-Y (0.5mm)"
                                font_size: '9sp'
                                on_release: app.jog_stage(0, -0.5, 0)
                            Widget:
                            Widget:

                        # Z Focus Controls
                        BoxLayout:
                            spacing: '2dp'
                            size_hint_y: None
                            height: '24dp'

                            Label:
                                text: "Z Focus:"
                                font_size: '10sp'
                                bold: True
                                size_hint_x: 0.2
                            Button:
                                text: "-100u"
                                font_size: '8sp'
                                on_release: app.jog_z_focus(-100.0)
                            Button:
                                text: "-10u"
                                font_size: '8sp'
                                on_release: app.jog_z_focus(-10.0)
                            Button:
                                text: "-1u"
                                font_size: '8sp'
                                on_release: app.jog_z_focus(-1.0)
                            Button:
                                text: "+1u"
                                font_size: '8sp'
                                on_release: app.jog_z_focus(1.0)
                            Button:
                                text: "+10u"
                                font_size: '8sp'
                                on_release: app.jog_z_focus(10.0)
                            Button:
                                text: "+100u"
                                font_size: '8sp'
                                on_release: app.jog_z_focus(100.0)

                    Button:
                        text: "Capture Snapshot PNG"
                        size_hint_y: None
                        height: '32dp'
                        background_color: (0.2, 0.6, 0.8, 1)
                        bold: True
                        font_size: '11sp'
                        on_release: app.capture_snapshot()

        # RIGHT COLUMN (Width: 52%): Embedded Microplate Registration Map & Channels Studio
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.52
            spacing: '8dp'

            # Microplate Map & Objective Selection Bar
            BoxLayout:
                size_hint_y: None
                height: '34dp'
                spacing: '8dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.12, 0.15, 0.20, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Plate Map:"
                    bold: True
                    font_size: '10sp'
                    size_hint_x: 0.20

                Spinner:
                    id: plate_format_spinner
                    text: "96-Well Plate"
                    values: ["6-Well Plate", "12-Well Plate", "24-Well Plate", "48-Well Plate", "96-Well Plate", "384-Well Plate"]
                    size_hint_x: 0.30
                    font_size: '10sp'
                    bold: True
                    on_text: app.change_well_plate_format(self.text)

                Label:
                    text: "Objective:"
                    bold: True
                    font_size: '10sp'
                    size_hint_x: 0.20

                Spinner:
                    id: main_objective_spinner
                    text: "20x Air"
                    values: ["1.25x", "4x", "5x", "10x", "20x Air", "20x", "40x", "60x Oil", "63x", "100x Oil"]
                    size_hint_x: 0.30
                    font_size: '10sp'
                    bold: True
                    on_text: app.set_objective_preset(self.text)

            # Embedded Microplate Canvas (Top-Right UI)
            InteractiveScaledPlateCanvas:
                id: scaled_canvas_tab1
                size_hint_y: 0.58

            Label:
                text: "Double-click any well to move stage focus directly to that well center."
                font_size: '9sp'
                size_hint_y: None
                height: '16dp'
                color: (0.7, 0.7, 0.7, 1)

            # Registration Target Wizard Buttons
            BoxLayout:
                size_hint_y: None
                height: '28dp'
                spacing: '6dp'

                Button:
                    text: "Mark Stage Position"
                    background_color: (0.2, 0.7, 0.3, 1)
                    bold: True
                    font_size: '10sp'
                    on_release: app.record_calibration_step(); scaled_canvas_tab1.redraw_canvas()

                Button:
                    text: "Finish Calibration"
                    background_color: (0.8, 0.4, 0.2, 1)
                    bold: True
                    font_size: '10sp'
                    on_release: app.finish_plate_calibration(); scaled_canvas_tab1.redraw_canvas()

                Button:
                    text: "Select All"
                    font_size: '10sp'
                    on_release: app.fov_manager.select_all_wells(); scaled_canvas_tab1.redraw_canvas()

                Button:
                    text: "Clear All"
                    font_size: '10sp'
                    on_release: app.fov_manager.clear_all_wells(); scaled_canvas_tab1.redraw_canvas()

            # Optical Channels Panel (Single Active Channel Mutual Exclusion)
            BoxLayout:
                orientation: 'vertical'
                spacing: '4dp'
                size_hint_y: 0.42

                Label:
                    text: "Optical Channels (Click to Illuminate)"
                    font_size: '12sp'
                    bold: True
                    size_hint_y: None
                    height: '20dp'
                    color: (0.3, 0.8, 1.0, 1)

                ScrollView:
                    BoxLayout:
                        id: main_channel_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '4dp'

                Button:
                    text: "[ Launch Plate Navigator Studio ]"
                    size_hint_y: None
                    height: '35dp'
                    background_color: (0.2, 0.7, 0.4, 1)
                    bold: True
                    font_size: '12sp'
                    on_release: app.open_navigator_popup()

    # Footer Status Bar
    BoxLayout:
        size_hint_y: None
        height: '26dp'
        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.12, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.status_msg
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            padding_x: '10dp'
            color: (0.7, 0.7, 0.7, 1)
            font_size: '10sp'
