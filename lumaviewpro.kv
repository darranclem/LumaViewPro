#:kivy 2.0.0

<ChannelControlWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '34dp'
    spacing: '6dp'

    ToggleButton:
        id: channel_toggle
        text: root.channel_name
        active: root.is_active
        state: 'down' if root.is_active else 'normal'
        size_hint_x: 0.35
        font_size: '11sp'
        bold: True
        background_normal: ''
        background_down: ''
        background_color: root.btn_bg_color if root.is_active else [root.btn_bg_color[0]*0.35, root.btn_bg_color[1]*0.35, root.btn_bg_color[2]*0.35, 1.0]
        on_release: app.select_channel(root.channel_name)

    Label:
        text: root.channel_spec_info
        size_hint_x: 0.45
        font_size: '10sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        color: (0.8, 0.8, 0.8, 1)

    Button:
        text: "Ref"
        size_hint_x: 0.20
        font_size: '10sp'
        on_release: root.open_ref_chooser()


<ZoomPanCameraWidget>:
    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: '4dp'
        spacing: '4dp'

        Label:
            text: "[ Live Camera Feed - Optical Viewport ]"
            size_hint_y: None
            height: '20dp'
            font_size: '11sp'
            bold: True
            color: (0.3, 0.8, 1.0, 1)

        Widget:
            id: viewport_box
            canvas:
                Color:
                    rgba: 0.12, 0.14, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

        BoxLayout:
            size_hint_y: None
            height: '24dp'
            spacing: '8dp'

            Label:
                text: "Wheel = Zoom | Right Drag = Pan | Double-Click = Center Pixel"
                font_size: '10sp'
                color: (0.7, 0.7, 0.7, 1)

            Button:
                text: "Reset View"
                size_hint_x: None
                width: '75dp'
                font_size: '10sp'
                on_release: root.reset_zoom_pan()


<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: '8dp'
    spacing: '8dp'

    # Top Navigation & Stage Coordinates Bar
    BoxLayout:
        size_hint_y: None
        height: '42dp'
        spacing: '10dp'
        padding: '6dp'
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.20, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Automation"
            font_size: '15sp'
            bold: True
            size_hint_x: 0.32
            color: (1, 1, 1, 1)

        Label:
            text: "Active Well: " + root.current_well_display
            font_size: '12sp'
            bold: True
            size_hint_x: 0.18
            color: (0.3, 0.8, 1.0, 1)

        Label:
            text: root.stage_coord_str
            size_hint_x: 0.30
            font_size: '11sp'
            bold: True
            color: (0.4, 0.8, 1.0, 1)

        Label:
            text: root.calibrated_status
            size_hint_x: 0.20
            font_size: '11sp'
            bold: True
            color: (0.2, 0.9, 0.4, 1) if "Calibrated" in root.calibrated_status else (0.9, 0.3, 0.3, 1)

    # Main Unified Single-Window Layout: 2 Columns
    BoxLayout:
        orientation: 'horizontal'
        spacing: '10dp'

        # LEFT COLUMN: Live Camera Feed & Hardware Control Deck (Width: 50%)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # Embedded Live Camera Feed
            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_y: 0.58

            # Hardware Control Deck Panel
            ScrollView:
                size_hint_y: 0.42
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '6dp'
                    padding: '6dp'
                    canvas.before:
                        Color:
                            rgba: 0.10, 0.11, 0.14, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    Label:
                        text: "Hardware Motion, Light & Camera Deck"
                        font_size: '12sp'
                        bold: True
                        size_hint_y: None
                        height: '20dp'
                        color: (0.3, 0.8, 1.0, 1)

                    # Camera Setup & Illumination Controls
                    GridLayout:
                        cols: 2
                        spacing: '6dp'
                        size_hint_y: None
                        height: '80dp'

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: '2dp'

                            BoxLayout:
                                Label:
                                    text: "Exp (ms):"
                                    font_size: '10sp'
                                TextInput:
                                    text: str(app.exposure_ms)
                                    multiline: False
                                    font_size: '10sp'
                                    on_text_validate: app.set_af_exposure(self.text)

                            BoxLayout:
                                Label:
                                    text: "Gain:"
                                    font_size: '10sp'
                                TextInput:
                                    text: str(app.gain)
                                    multiline: False
                                    font_size: '10sp'

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: '2dp'

                            ToggleButton:
                                text: "Light: ON" if app.is_light_on else "Light: OFF"
                                state: 'down' if app.is_light_on else 'normal'
                                font_size: '11sp'
                                bold: True
                                background_color: (0.2, 0.8, 0.4, 1) if app.is_light_on else (0.4, 0.4, 0.4, 1)
                                on_release: app.toggle_light_state(self.state == 'down')

                            BoxLayout:
                                Label:
                                    text: "LED Power (%):"
                                    font_size: '10sp'
                                TextInput:
                                    text: str(app.led_power)
                                    multiline: False
                                    font_size: '10sp'
                                    on_text_validate: app.led_power = float(self.text) if self.text else 100.0

                    # Motion Stage XY & Z Focus Motion Deck
                    GridLayout:
                        cols: 2
                        spacing: '6dp'
                        size_hint_y: None
                        height: '115dp'

                        # XY Stage Jogging (Large & Fine Step Buttons)
                        BoxLayout:
                            orientation: 'vertical'
                            spacing: '2dp'

                            Label:
                                text: "XY Stage Motion"
                                font_size: '10sp'
                                bold: True

                            GridLayout:
                                cols: 5
                                spacing: '2dp'
                                size_hint_y: None
                                height: '55dp'

                                Widget:
                                Button:
                                    text: "++Y"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(0, 5.0, 0)
                                Button:
                                    text: "+Y"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(0, 0.5, 0)
                                Button:
                                    text: "--Y"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(0, -5.0, 0)
                                Widget:

                                Button:
                                    text: "--X"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(-5.0, 0, 0)
                                Button:
                                    text: "-X"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(-0.5, 0, 0)
                                Button:
                                    text: "0"
                                    font_size: '9sp'
                                    on_release: app.jog_stage_to(-49.5, 31.5)
                                Button:
                                    text: "+X"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(0.5, 0, 0)
                                Button:
                                    text: "++X"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(5.0, 0, 0)

                                Widget:
                                Widget:
                                Button:
                                    text: "-Y"
                                    font_size: '9sp'
                                    on_release: app.jog_stage(0, -0.5, 0)
                                Widget:
                                Widget:

                        # Z Focus Fine & Coarse Jogging
                        BoxLayout:
                            orientation: 'vertical'
                            spacing: '2dp'

                            Label:
                                text: "Z Focus Motor Controls"
                                font_size: '10sp'
                                bold: True

                            GridLayout:
                                cols: 3
                                spacing: '2dp'

                                Button:
                                    text: "+100u"
                                    font_size: '9sp'
                                    on_release: app.jog_z_focus(100.0)
                                Button:
                                    text: "+10u"
                                    font_size: '9sp'
                                    on_release: app.jog_z_focus(10.0)
                                Button:
                                    text: "+1u"
                                    font_size: '9sp'
                                    on_release: app.jog_z_focus(1.0)

                                Button:
                                    text: "-100u"
                                    font_size: '9sp'
                                    on_release: app.jog_z_focus(-100.0)
                                Button:
                                    text: "-10u"
                                    font_size: '9sp'
                                    on_release: app.jog_z_focus(-10.0)
                                Button:
                                    text: "-1u"
                                    font_size: '9sp'
                                    on_release: app.jog_z_focus(-1.0)

                            BoxLayout:
                                Label:
                                    text: "AF Range (+/-um):"
                                    font_size: '9sp'
                                TextInput:
                                    text: str(app.focus_map.af_search_range_um)
                                    multiline: False
                                    font_size: '9sp'
                                    on_text_validate: app.set_af_search_range(self.text)

                    # Objective Preset Spinner & Capture Snapshot
                    BoxLayout:
                        size_hint_y: None
                        height: '28dp'
                        spacing: '6dp'

                        Label:
                            text: "Objective Preset:"
                            size_hint_x: 0.35
                            font_size: '10sp'
                            bold: True

                        Spinner:
                            text: "20x Air"
                            values: ["1.25x", "4x", "5x", "10x", "20x Air", "20x", "40x", "60x Oil", "63x", "100x Oil"]
                            size_hint_x: 0.40
                            font_size: '10sp'
                            on_text: app.set_objective_preset(self.text)

                        Button:
                            text: "Capture PNG"
                            size_hint_x: 0.25
                            background_color: (0.2, 0.6, 0.8, 1)
                            font_size: '10sp'
                            bold: True
                            on_release: app.capture_snapshot()

        # RIGHT COLUMN: Embedded Microplate Registration Studio (Width: 50%)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '6dp'

            # Microplate Map Format Selection Header
            BoxLayout:
                size_hint_y: None
                height: '32dp'
                spacing: '8dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.14, 0.16, 0.22, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Plate Format Map:"
                    bold: True
                    font_size: '11sp'
                    size_hint_x: 0.4
                    color: (0.3, 0.8, 1.0, 1)

                Spinner:
                    id: plate_format_spinner
                    text: "96-Well Plate"
                    values: ["6-Well Plate", "12-Well Plate", "24-Well Plate", "48-Well Plate", "96-Well Plate", "384-Well Plate"]
                    size_hint_x: 0.6
                    font_size: '11sp'
                    bold: True
                    on_text: app.set_well_plate_format(self.text)

            # Embedded Studio Tabbed Panel
            TabbedPanel:
                id: main_tabbed_panel
                do_default_tab: False
                tab_width: '140dp'

                # TAB 1: Calibration & Microplate Registration Studio
                TabbedPanelItem:
                    text: '1. Calibration'
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '6dp'
                        padding: '6dp'

                        InteractiveScaledPlateCanvas:
                            id: scaled_canvas_tab1
                            size_hint_y: 0.65

                        Label:
                            text: "Double-click any well to move stage directly to well center."
                            font_size: '10sp'
                            size_hint_y: None
                            height: '18dp'
                            color: (0.7, 0.7, 0.7, 1)

                        BoxLayout:
                            size_hint_y: None
                            height: '28dp'
                            spacing: '6dp'

                            Button:
                                text: "Select All"
                                font_size: '10sp'
                                on_release: app.fov_manager.select_all_wells(); scaled_canvas_tab1.redraw_canvas()

                            Button:
                                text: "Clear All"
                                font_size: '10sp'
                                on_release: app.fov_manager.clear_all_wells(); scaled_canvas_tab1.redraw_canvas()

                            Button:
                                text: "Sync Channels"
                                background_color: (0.2, 0.5, 0.8, 1)
                                font_size: '10sp'
                                bold: True
                                on_release: app.global_sync_active_channels()

                        # Precision 6-Point Target Registration Wizard
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: '110dp'
                            padding: '4dp'
                            spacing: '4dp'
                            canvas.before:
                                Color:
                                    rgba: 0.14, 0.14, 0.20, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: '22dp'
                                spacing: '6dp'

                                Label:
                                    text: "Calib Channel:"
                                    size_hint_x: 0.35
                                    bold: True
                                    font_size: '10sp'

                                Spinner:
                                    text: "Brightfield"
                                    values: ["Brightfield", "Phase", "Darkfield", "Blue", "Green", "Red"]
                                    size_hint_x: 0.65
                                    font_size: '10sp'
                                    on_text: app.set_primary_af_channel(self.text)

                            Label:
                                text: "Move stage to target rims on microplate map to compute registration."
                                size_hint_y: None
                                height: '18dp'
                                color: (0.9, 0.9, 0.2, 1)
                                font_size: '10sp'

                            BoxLayout:
                                size_hint_y: None
                                height: '28dp'
                                spacing: '8dp'

                                Button:
                                    text: "Mark Stage Position"
                                    background_color: (0.2, 0.7, 0.3, 1)
                                    bold: True
                                    font_size: '10sp'
                                    on_release: app.record_calibration_step(); scaled_canvas_tab1.redraw_canvas()

                                Button:
                                    text: "Finish Calibration"
                                    background_color: (0.8, 0.4, 0.2, 1)
                                    bold: True
                                    font_size: '10sp'
                                    on_release: app.finish_plate_calibration(); scaled_canvas_tab1.redraw_canvas()

                # TAB 2: AF Dialogue & Time-Lapse Schedule
                TabbedPanelItem:
                    text: '2. AF Dialogue'
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '8dp'
                        padding: '8dp'

                        Label:
                            text: "Autofocus Search Scan & Time-Lapse Schedule"
                            font_size: '13sp'
                            bold: True
                            size_hint_y: None
                            height: '22dp'

                        Button:
                            text: "Set Stage Position as Master Auto Point (Red)"
                            size_hint_y: None
                            height: '28dp'
                            background_color: (0.8, 0.2, 0.2, 1)
                            bold: True
                            font_size: '11sp'
                            on_release: app.set_master_auto_point(); scaled_canvas_tab1.redraw_canvas()

                        Button:
                            text: "Test Autofocus Acquisition"
                            size_hint_y: None
                            height: '28dp'
                            background_color: (0.2, 0.6, 0.8, 1)
                            bold: True
                            font_size: '11sp'
                            on_release: app.test_autofocus_run()

                        Widget:

                # TAB 3: Hardware Protocol & Tiling Matrix
                TabbedPanelItem:
                    text: '3. Protocol Engine'
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '8dp'
                        padding: '8dp'

                        Label:
                            text: "Hardware Protocol Engine & 12x12 Tiling"
                            font_size: '13sp'
                            bold: True
                            size_hint_y: None
                            height: '22dp'

                        Button:
                            text: "Apply Protocol to Experiment Execution Engine & Save"
                            size_hint_y: None
                            height: '38dp'
                            background_color: (0.2, 0.7, 0.4, 1)
                            bold: True
                            font_size: '12sp'
                            on_release: app.generate_and_apply_protocol()

                        Widget:

            # Optical Channels Selection Panel (Single Channel Selected)
            Label:
                text: "Optical Channels (Select One to Illuminate)"
                font_size: '11sp'
                bold: True
                size_hint_y: None
                height: '20dp'
                color: (0.4, 0.8, 1.0, 1)

            BoxLayout:
                id: main_channel_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '4dp'

    # Bottom Status Bar
    BoxLayout:
        size_hint_y: None
        height: '26dp'
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.status_msg
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            padding_x: '10dp'
            color: (0.7, 0.7, 0.7, 1)
            font_size: '10sp'
