#:kivy 2.0.0

<ChannelControlWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '34dp'
    spacing: '6dp'
    padding: ['2dp', '2dp']

    ToggleButton:
        id: channel_toggle
        text: root.channel_name
        active: root.is_active
        state: 'down' if root.is_active else 'normal'
        size_hint_x: 0.35
        bold: True
        background_normal: ''
        background_down: ''
        background_color: root.btn_bg_color if root.is_active else [root.btn_bg_color[0]*0.35, root.btn_bg_color[1]*0.35, root.btn_bg_color[2]*0.35, 1.0]
        color: (1, 1, 1, 1)
        on_state: app.on_channel_toggle(root.channel_name, self.state == 'down')

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.45
        spacing: '1dp'

        Label:
            text: root.channel_spec_info
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.85, 0.85, 0.85, 1)

        Label:
            text: "Ref: " + root.ref_image_path
            font_size: '9sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: (0.6, 0.7, 0.8, 1)

    Button:
        text: "Load Ref"
        size_hint_x: 0.20
        font_size: '9sp'
        on_release: root.open_ref_chooser()


<ZoomPanCameraWidget>:
    # Canvas rendering is handled in Python (_update_canvas)
    Widget:


<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: '8dp'
    spacing: '8dp'

    # Top Navigation & Status Header Bar
    BoxLayout:
        size_hint_y: None
        height: '40dp'
        spacing: '10dp'
        padding: '6dp'
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.20, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Automation"
            font_size: '15sp'
            bold: True
            size_hint_x: 0.35
            color: (1, 1, 1, 1)

        Label:
            text: "Well: " + root.current_well_display
            font_size: '12sp'
            bold: True
            size_hint_x: 0.15
            color: (0.3, 0.8, 1.0, 1)

        Label:
            text: root.stage_coord_str
            size_hint_x: 0.30
            font_size: '11sp'
            bold: True
            color: (0.4, 0.8, 1.0, 1)

        Label:
            text: root.calibrated_status
            size_hint_x: 0.20
            font_size: '11sp'
            bold: True
            color: (0.2, 0.9, 0.4, 1) if "Calibrated" in root.calibrated_status else (0.9, 0.3, 0.3, 1)

    # Main Single-Window Content Layout: 2 Equal Columns
    BoxLayout:
        orientation: 'horizontal'
        spacing: '10dp'

        # LEFT COLUMN (50% Width): Top-Left Live Viewport + Bottom-Left Hardware Deck
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # TOP-LEFT: Embedded Live Camera Viewport with Center Reticle Crosshairs & Double-Click Pixel Centering
            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_y: 0.58

            # BOTTOM-LEFT: Hardware Motion, Illumination & Camera Control Deck
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.42
                spacing: '4dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: 0.10, 0.11, 0.14, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Microscope Hardware & Motion Controls"
                    font_size: '11sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: (0.3, 0.8, 1.0, 1)

                GridLayout:
                    cols: 3
                    spacing: '4dp'

                    # 1. Illumination & Camera Setup Panel
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '2dp'
                        padding: '3dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Camera & Light"
                            bold: True
                            font_size: '10sp'

                        ToggleButton:
                            id: master_light_toggle
                            text: "Light: ON" if app.is_light_on else "Light: OFF"
                            state: 'down' if app.is_light_on else 'normal'
                            font_size: '10sp'
                            bold: True
                            background_color: (0.2, 0.8, 0.3, 1) if app.is_light_on else (0.5, 0.2, 0.2, 1)
                            on_state: app.toggle_light_master(self.state == 'down')

                        BoxLayout:
                            Label:
                                text: "Exp (ms):"
                                font_size: '9sp'
                            TextInput:
                                text: str(app.camera_exposure_ms)
                                multiline: False
                                font_size: '9sp'
                                on_text_validate: app.set_camera_exposure(self.text)

                        BoxLayout:
                            Label:
                                text: "Gain:"
                                font_size: '9sp'
                            TextInput:
                                text: str(app.camera_gain)
                                multiline: False
                                font_size: '9sp'
                                on_text_validate: app.set_camera_gain(self.text)

                        BoxLayout:
                            Label:
                                text: "LED %:"
                                font_size: '9sp'
                            TextInput:
                                text: str(app.led_power)
                                multiline: False
                                font_size: '9sp'
                                on_text_validate: app.led_power = float(self.text) if self.text else 100.0

                        Button:
                            text: "Capture PNG"
                            background_color: (0.2, 0.6, 0.8, 1)
                            font_size: '9sp'
                            bold: True
                            on_release: app.capture_snapshot()

                    # 2. XY Motion Jog Deck in Cross / DPAD
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '2dp'
                        padding: '3dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "XY Stage Jog Cross"
                            bold: True
                            font_size: '10sp'

                        GridLayout:
                            cols: 3
                            spacing: '2dp'

                            # Row 1: Top (+Y)
                            Widget:
                            BoxLayout:
                                spacing: '1dp'
                                Button:
                                    text: "+Y"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(0, 0.5, 0)
                                Button:
                                    text: "++Y"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(0, 5.0, 0)
                            Widget:

                            # Row 2: Middle (-X, Home A1, +X)
                            BoxLayout:
                                spacing: '1dp'
                                Button:
                                    text: "--X"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(-5.0, 0, 0)
                                Button:
                                    text: "-X"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(-0.5, 0, 0)
                            Button:
                                text: "A1"
                                font_size: '8sp'
                                bold: True
                                background_color: (0.2, 0.6, 0.8, 1)
                                on_release: app.zero_stage()
                            BoxLayout:
                                spacing: '1dp'
                                Button:
                                    text: "+X"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(0.5, 0, 0)
                                Button:
                                    text: "++X"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(5.0, 0, 0)

                            # Row 3: Bottom (-Y)
                            Widget:
                            BoxLayout:
                                spacing: '1dp'
                                Button:
                                    text: "-Y"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(0, -0.5, 0)
                                Button:
                                    text: "--Y"
                                    font_size: '8sp'
                                    bold: True
                                    on_release: app.jog_stage(0, -5.0, 0)
                            Widget:

                        BoxLayout:
                            Label:
                                text: "XY Step:"
                                font_size: '9sp'
                            Spinner:
                                text: "1.0 mm"
                                values: ["0.1 mm", "0.5 mm", "1.0 mm", "5.0 mm"]
                                font_size: '9sp'
                                on_text: app.set_jog_step(self.text)

                    # 3. Z Focus Column
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '2dp'
                        padding: '3dp'
                        canvas.before:
                            Color:
                                rgba: 0.14, 0.16, 0.20, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size

                        Label:
                            text: "Z Focus Motor"
                            bold: True
                            font_size: '10sp'

                        GridLayout:
                            cols: 2
                            spacing: '2dp'

                            Button:
                                text: "++Z (+100u)"
                                font_size: '8sp'
                                on_release: app.jog_z(100.0)
                            Button:
                                text: "+Z (+10u)"
                                font_size: '8sp'
                                on_release: app.jog_z(10.0)
                            Button:
                                text: "+1u"
                                font_size: '8sp'
                                on_release: app.jog_z(1.0)
                            Button:
                                text: "-1u"
                                font_size: '8sp'
                                on_release: app.jog_z(-1.0)
                            Button:
                                text: "-Z (-10u)"
                                font_size: '8sp'
                                on_release: app.jog_z(-10.0)
                            Button:
                                text: "--Z (-100u)"
                                font_size: '8sp'
                                on_release: app.jog_z(-100.0)

                        BoxLayout:
                            Label:
                                text: "AF Range:"
                                font_size: '9sp'
                            TextInput:
                                text: "50.0"
                                multiline: False
                                font_size: '9sp'
                                on_text_validate: app.focus_map.af_search_range_um = float(self.text) if self.text else 50.0

        # RIGHT COLUMN (50% Width): Microplate Canvas (Top-Right) & Optical Channels Panel (Bottom-Right)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.50
            spacing: '8dp'

            # TOP-RIGHT: Embedded Interactive Microplate Map Display & Selectors
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.58
                spacing: '4dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.12, 0.14, 0.18, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                # Format & Objective Selectors Bar
                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '6dp'

                    Label:
                        text: "Format:"
                        bold: True
                        font_size: '10sp'
                        size_hint_x: 0.18
                        color: (0.3, 0.8, 1.0, 1)

                    Spinner:
                        id: plate_format_spinner
                        text: "96-Well Plate"
                        values: ["6-Well Plate", "12-Well Plate", "24-Well Plate", "48-Well Plate", "96-Well Plate", "384-Well Plate"]
                        font_size: '10sp'
                        bold: True
                        size_hint_x: 0.35
                        on_text: app.set_well_plate_format(self.text)

                    Label:
                        text: "Objective:"
                        bold: True
                        font_size: '10sp'
                        size_hint_x: 0.18
                        color: (0.3, 0.8, 1.0, 1)

                    Spinner:
                        id: main_objective_spinner
                        text: "20x Air"
                        values: ["1.25x", "4x", "5x", "10x", "20x Air", "20x", "40x", "60x Oil", "63x", "100x Oil"]
                        font_size: '10sp'
                        bold: True
                        size_hint_x: 0.29
                        on_text: app.set_objective_preset(self.text)

                # Interactive Microplate Canvas Map (A1 Top-Left)
                InteractiveScaledPlateCanvas:
                    id: main_plate_canvas

                Label:
                    text: "Double-click any well to move stage focus directly to that well position"
                    font_size: '9sp'
                    size_hint_y: None
                    height: '14dp'
                    color: (0.7, 0.8, 0.9, 1)

            # BOTTOM-RIGHT: Optical Channels & Calibration/Protocol Studio
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.42
                spacing: '4dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.10, 0.11, 0.14, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Optical Channels (Select One to Illuminate)"
                    font_size: '11sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: (0.4, 0.8, 1.0, 1)

                # Scrollable Optical Channels List
                ScrollView:
                    size_hint_y: 0.55
                    BoxLayout:
                        id: main_channel_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: '3dp'

                # Calibration & Protocol Studio Buttons
                BoxLayout:
                    size_hint_y: 0.45
                    spacing: '6dp'

                    Button:
                        text: "Mark 6-Pt Target"
                        background_color: (0.2, 0.7, 0.3, 1)
                        font_size: '10sp'
                        bold: True
                        on_release: app.record_calibration_step()

                    Button:
                        text: "Finish Calib"
                        background_color: (0.8, 0.4, 0.2, 1)
                        font_size: '10sp'
                        bold: True
                        on_release: app.finish_plate_calibration()

                    Button:
                        text: "Master Auto Pt"
                        background_color: (0.8, 0.2, 0.2, 1)
                        font_size: '10sp'
                        bold: True
                        on_release: app.set_master_auto_point()

                    Button:
                        text: "Save Protocol"
                        background_color: (0.2, 0.6, 0.8, 1)
                        font_size: '10sp'
                        bold: True
                        on_release: app.generate_and_apply_protocol()

    # Footer Status Bar
    BoxLayout:
        size_hint_y: None
        height: '24dp'
        canvas.before:
            Color:
                rgba: 0.1, 0.1, 0.1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.status_msg
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            padding_x: '8dp'
            color: (0.7, 0.7, 0.7, 1)
            font_size: '10sp'
