#:kivy 2.3.0

<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: ('6dp', '4dp')
    spacing: '4dp'

    # Top Status & Stage Bar
    BoxLayout:
        size_hint_y: None
        height: '38dp'
        spacing: '8dp'
        padding: ('8dp', '2dp')
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.18, 1.0
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Control System"
            font_size: '16sp'
            bold: True
            color: 0.2, 0.8, 1.0, 1.0
            size_hint_x: 0.35
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: app.status_msg
            font_size: '13sp'
            color: 0.8, 0.8, 0.2, 1.0
            size_hint_x: 0.25
            halign: 'center'
            valign: 'middle'

        Label:
            text: app.stage_coord_str
            font_size: '13sp'
            color: 0.9, 0.9, 0.9, 1.0
            size_hint_x: 0.40
            halign: 'right'
            valign: 'middle'
            text_size: self.size

    # Main Center View Area
    BoxLayout:
        orientation: 'horizontal'
        spacing: '6dp'

        # Camera Viewport & Vertical Z Slider
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: 0.62
            spacing: '4dp'

            ZoomPanCameraWidget:
                id: main_camera_viewport
                size_hint_x: 0.88

            # Vertical Z Focus Slider Panel
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.12
                spacing: '2dp'
                padding: ('2dp', '4dp')
                canvas.before:
                    Color:
                        rgba: 0.14, 0.16, 0.20, 1.0
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Lens Z"
                    font_size: '11sp'
                    bold: True
                    size_hint_y: None
                    height: '16dp'
                    color: 0.2, 0.8, 1.0, 1.0

                Button:
                    text: 'Z++'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '24dp'
                    on_press: app.jog_z(0.10)

                Button:
                    text: 'Z+'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '24dp'
                    on_press: app.jog_z(0.01)

                Button:
                    text: 'z+'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '22dp'
                    on_press: app.jog_z(0.001)

                Slider:
                    orientation: 'vertical'
                    min: -10.0
                    max: 10.0
                    value: app.stage_z
                    on_value: app.set_z_focus_absolute(self.value)

                Button:
                    text: 'z-'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '22dp'
                    on_press: app.jog_z(-0.001)

                Button:
                    text: 'Z-'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '24dp'
                    on_press: app.jog_z(-0.01)

                Button:
                    text: 'Z--'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '24dp'
                    on_press: app.jog_z(-0.10)

                Button:
                    text: 'Zero'
                    font_size: '10sp'
                    size_hint_y: None
                    height: '22dp'
                    on_press: app.zero_z_baseline()

        # Right Control Column (Plate Canvas + Control Panels)
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.38
            spacing: '4dp'

            # Plate Navigator Canvas
            InteractiveScaledPlateCanvas:
                id: main_plate_canvas
                size_hint_y: 0.40

            # Illumination & Hardware Control Panel
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.60
                spacing: '3dp'
                padding: '4dp'
                canvas.before:
                    Color:
                        rgba: 0.15, 0.17, 0.22, 1.0
                    Rectangle:
                        pos: self.pos
                        size: self.size

                Label:
                    text: "Illumination & Camera Settings"
                    font_size: '13sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: 0.3, 0.8, 1.0, 1.0

                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '4dp'
                    Label:
                        text: "Exposure: " + str(round(app.camera_exposure_ms, 1)) + " ms"
                        size_hint_x: 0.40
                        font_size: '11sp'
                    Slider:
                        min: 0.1
                        max: 200.0
                        value: app.camera_exposure_ms
                        on_value: app.set_camera_exposure(self.value)
                        size_hint_x: 0.60

                BoxLayout:
                    size_hint_y: None
                    height: '26dp'
                    spacing: '4dp'
                    Label:
                        text: "LED Power: " + str(int(app.led_power_pct)) + "%"
                        size_hint_x: 0.40
                        font_size: '11sp'
                    Slider:
                        min: 0
                        max: 100
                        value: app.led_power_pct
                        on_value: app.set_led_power(self.value)
                        size_hint_x: 0.60

                Label:
                    text: "Optical Illumination Channels"
                    font_size: '13sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: 0.3, 0.8, 1.0, 1.0

                GridLayout:
                    cols: 4
                    spacing: '2dp'
                    size_hint_y: None
                    height: '52dp'
                    Button:
                        text: 'Brightfield'
                        font_size: '10sp'
                        on_press: app.set_active_channel('BF')
                    Button:
                        text: 'Phase (PC)'
                        font_size: '10sp'
                        on_press: app.set_active_channel('PC')
                    Button:
                        text: 'Darkfield (DF)'
                        font_size: '10sp'
                        on_press: app.set_active_channel('DF')
                    Button:
                        text: 'Violet (405)'
                        font_size: '10sp'
                        on_press: app.set_active_channel('VIOLET')
                    Button:
                        text: 'Blue (470)'
                        font_size: '10sp'
                        on_press: app.set_active_channel('BLUE')
                    Button:
                        text: 'Green (530)'
                        font_size: '10sp'
                        on_press: app.set_active_channel('GREEN')
                    Button:
                        text: 'Red (625)'
                        font_size: '10sp'
                        on_press: app.set_active_channel('RED')
                    Button:
                        text: 'ALL LEDs OFF'
                        font_size: '10sp'
                        background_color: (0.8, 0.2, 0.2, 1.0)
                        on_press: app.turn_off_all_leds()

                Label:
                    text: "Focus Map & Stage Motion"
                    font_size: '13sp'
                    bold: True
                    size_hint_y: None
                    height: '18dp'
                    color: 0.3, 0.8, 1.0, 1.0

                GridLayout:
                    cols: 3
                    spacing: '3dp'
                    size_hint_y: None
                    height: '26dp'
                    Button:
                        text: '+ Focus Pt'
                        font_size: '10sp'
                        on_press: app.add_current_focus_map_point()
                    Button:
                        text: '+ AF Pt'
                        font_size: '10sp'
                        on_press: app.add_current_autofocus_point()
                    Button:
                        text: 'Autofocus'
                        font_size: '10sp'
                        on_press: app.run_autofocus()

                GridLayout:
                    cols: 3
                    spacing: '3dp'
                    size_hint_y: None
                    height: '60dp'

                    Widget:
                    Button:
                        text: 'Y+ (Up)'
                        font_size: '10sp'
                        on_press: app.jog_stage(0, 1)
                    Widget:

                    Button:
                        text: 'X- (Left)'
                        font_size: '10sp'
                        on_press: app.jog_stage(-1, 0)
                    Button:
                        text: 'Home Stage'
                        font_size: '10sp'
                        on_press: app.home_stage_and_synchronize()
                    Button:
                        text: 'X+ (Right)'
                        font_size: '10sp'
                        on_press: app.jog_stage(1, 0)

                    Widget:
                    Button:
                        text: 'Y- (Down)'
                        font_size: '10sp'
                        on_press: app.jog_stage(0, -1)
                    Widget:
