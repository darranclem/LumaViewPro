#:kivy 2.3
#:set BG (0.118, 0.118, 0.129, 1)
#:set PANEL (0.161, 0.165, 0.180, 1)
#:set PANEL2 (0.196, 0.200, 0.216, 1)
#:set ACCENT (0.0, 0.62, 0.84, 1)
#:set TXT (0.88, 0.89, 0.90, 1)
#:set TXT_DIM (0.60, 0.62, 0.65, 1)

<FlatButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: PANEL2
    color: TXT
    font_size: '12sp'
    size_hint_y: None
    height: '28dp'

<AccentButton@FlatButton>:
    background_color: ACCENT

<StopButton@FlatButton>:
    background_color: (0.75, 0.20, 0.17, 1)

<PanelLabel@Label>:
    color: TXT_DIM
    font_size: '11sp'
    size_hint_y: None
    height: '18dp'
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<HeaderLabel@Label>:
    color: ACCENT
    bold: True
    font_size: '12sp'
    size_hint_y: None
    height: '22dp'
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<SmallInput@TextInput>:
    multiline: False
    write_tab: False
    background_color: (0.09, 0.09, 0.10, 1)
    foreground_color: TXT
    cursor_color: ACCENT
    font_size: '12sp'
    size_hint_y: None
    height: '26dp'
    padding: ['6dp', '4dp']

<DarkSpinner@Spinner>:
    background_normal: ''
    background_down: ''
    background_color: PANEL2
    color: TXT
    font_size: '12sp'
    size_hint_y: None
    height: '28dp'

<FieldRow@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: '26dp'
    spacing: '4dp'

LumaViewProMainLayout:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size

    # ============================= TOP TOOLBAR =============================
    BoxLayout:
        size_hint_y: None
        height: '38dp'
        padding: '6dp', '4dp'
        spacing: '6dp'
        canvas.before:
            Color:
                rgba: PANEL
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'LumaViewPro Navigator'
            color: ACCENT
            bold: True
            font_size: '15sp'
            size_hint_x: None
            width: '190dp'
        Label:
            text: 'Depth:'
            color: TXT_DIM
            font_size: '12sp'
            size_hint_x: None
            width: '42dp'
        DarkSpinner:
            id: bit_depth_spinner
            size_hint_x: None
            width: '70dp'
            text: app.bit_depth
            values: app.bit_depth_options
            on_text: app.set_bit_depth(self.text)
        Label:
            text: 'Binning:'
            color: TXT_DIM
            font_size: '12sp'
            size_hint_x: None
            width: '50dp'
        DarkSpinner:
            id: binning_spinner
            size_hint_x: None
            width: '52dp'
            text: app.binning
            values: ['1', '2', '3', '4']
            on_text: app.binning = self.text; app.set_binning(self.text)
        FlatButton:
            text: 'Crosshair: ' + ('ON' if app.crosshair_on else 'off')
            size_hint_x: None
            width: '96dp'
            background_color: ACCENT if app.crosshair_on else PANEL2
            on_press: app.crosshair_on = not app.crosshair_on
        FlatButton:
            text: 'Autoscale: ' + ('ON' if app.autoscale_on else 'off')
            size_hint_x: None
            width: '100dp'
            background_color: ACCENT if app.autoscale_on else PANEL2
            on_press: app.autoscale_on = not app.autoscale_on
        FlatButton:
            text: 'Shading: ' + ('ON' if app.shading_on else 'off')
            size_hint_x: None
            width: '92dp'
            background_color: ACCENT if app.shading_on else PANEL2
            on_press: app.toggle_shading(not app.shading_on)
        FlatButton:
            text: 'Snap'
            size_hint_x: None
            width: '58dp'
            on_press: app.snap_image()
        Widget:
        StopButton:
            text: 'STOP JOB'
            size_hint_x: None
            width: '86dp'
            opacity: 1 if app.worker_busy else 0.35
            on_press: app.cancel_job()

    # ============================== MAIN AREA ==============================
    BoxLayout:
        orientation: 'horizontal'
        spacing: '4dp'
        padding: '4dp'

        # ---------------- LEFT: channels + acquisition ----------------
        ScrollView:
            size_hint_x: None
            width: '250dp'
            do_scroll_x: False
            bar_width: '4dp'
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '4dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: PANEL
                    Rectangle:
                        pos: self.pos
                        size: self.size

                HeaderLabel:
                    text: 'LIVE CHANNEL'
                FlatButton:
                    text: 'Next channel  >>'
                    on_press: app.cycle_channel()
                GridLayout:
                    cols: 4
                    spacing: '3dp'
                    size_hint_y: None
                    height: '62dp'
                    FlatButton:
                        text: 'BF'
                        background_color: ACCENT if app.live_channel == 'BF' else PANEL2
                        on_press: app.set_live('BF')
                    FlatButton:
                        text: 'PC'
                        background_color: ACCENT if app.live_channel == 'PC' else PANEL2
                        on_press: app.set_live('PC')
                    FlatButton:
                        text: 'DF'
                        background_color: ACCENT if app.live_channel == 'DF' else PANEL2
                        on_press: app.set_live('DF')
                    FlatButton:
                        text: 'OFF'
                        background_color: (0.75, 0.20, 0.17, 1) if app.live_channel == 'OFF' else PANEL2
                        on_press: app.set_live('OFF')
                    FlatButton:
                        text: 'Blue'
                        color: (0.3, 0.95, 1.0, 1)
                        background_color: ACCENT if app.live_channel == 'BLUE' else PANEL2
                        on_press: app.set_live('BLUE')
                    FlatButton:
                        text: 'Green'
                        color: (0.35, 0.95, 0.35, 1)
                        background_color: ACCENT if app.live_channel == 'GREEN' else PANEL2
                        on_press: app.set_live('GREEN')
                    FlatButton:
                        text: 'Red'
                        color: (1.0, 0.4, 0.3, 1)
                        background_color: ACCENT if app.live_channel == 'RED' else PANEL2
                        on_press: app.set_live('RED')
                    Widget:

                HeaderLabel:
                    text: 'CHANNEL SETTINGS'
                FieldRow:
                    PanelLabel:
                        text: 'Channel'
                        size_hint_x: 0.45
                    DarkSpinner:
                        id: channel_spinner
                        text: app.selected_channel
                        values: ['BF', 'PC', 'DF', 'BLUE', 'GREEN', 'RED']
                        on_text: app.select_channel(self.text)
                FieldRow:
                    PanelLabel:
                        text: 'Exposure (ms)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: exposure_input
                        text: '20'
                Slider:
                    id: exposure_slider
                    min: 1
                    max: 1000
                    value: 20
                    size_hint_y: None
                    height: '24dp'
                    cursor_size: '14dp', '14dp'
                    on_value: app.slider_changed('exposure', self.value)
                FieldRow:
                    PanelLabel:
                        text: 'Gain (dB)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: gain_input
                        text: '0'
                Slider:
                    id: gain_slider
                    min: 0
                    max: 48
                    value: 0
                    size_hint_y: None
                    height: '24dp'
                    cursor_size: '14dp', '14dp'
                    on_value: app.slider_changed('gain', self.value)
                FieldRow:
                    PanelLabel:
                        text: 'LED power (mA)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: led_input
                        text: '50'
                Slider:
                    id: led_slider
                    min: 0
                    max: 600
                    value: 50
                    size_hint_y: None
                    height: '24dp'
                    cursor_size: '14dp', '14dp'
                    on_value: app.slider_changed('led', self.value)
                FieldRow:
                    PanelLabel:
                        text: 'Colour Z offset (um)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: zoffset_input
                        text: '0'
                FieldRow:
                    PanelLabel:
                        text: 'Use in protocol'
                        size_hint_x: 0.75
                    CheckBox:
                        id: channel_enabled_chk
                        active: True
                        size_hint_x: 0.25
                AccentButton:
                    text: 'Apply channel settings'
                    on_press: app.apply_channel_fields()

                HeaderLabel:
                    text: 'CORRECTIONS (all optional)'
                FlatButton:
                    text: 'Focus surface: ' + ('ON' if app.use_surface_on else 'off')
                    background_color: ACCENT if app.use_surface_on else PANEL2
                    on_press: app.use_surface_on = not app.use_surface_on
                FlatButton:
                    text: 'Colour Z offsets: ' + ('ON' if app.use_z_offsets_on else 'off')
                    background_color: ACCENT if app.use_z_offsets_on else PANEL2
                    on_press: app.use_z_offsets_on = not app.use_z_offsets_on
                FlatButton:
                    text: 'Shading: ' + ('ON' if app.shading_on else 'off')
                    background_color: ACCENT if app.shading_on else PANEL2
                    on_press: app.toggle_shading(not app.shading_on)

                HeaderLabel:
                    text: 'Z-STACK (per channel)'
                FieldRow:
                    PanelLabel:
                        text: 'Stack this channel'
                        size_hint_x: 0.75
                    CheckBox:
                        id: zstack_enabled_chk
                        size_hint_x: 0.25
                FieldRow:
                    PanelLabel:
                        text: 'Range (um)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: zstack_range_input
                        text: '50'
                FieldRow:
                    PanelLabel:
                        text: 'Step (um)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: zstack_step_input
                        text: '5'
                FieldRow:
                    FlatButton:
                        text: 'Stack marked'
                        on_press: app.run_zstack(all_channels=False)
                    FlatButton:
                        text: 'Stack all'
                        on_press: app.run_zstack(all_channels=True)

                HeaderLabel:
                    text: 'AUTOFOCUS'
                FieldRow:
                    PanelLabel:
                        text: 'Bottom (um)'
                        size_hint_x: 0.45
                    SmallInput:
                        id: af_bottom_input
                        text: '0'
                    FlatButton:
                        text: 'here'
                        size_hint_x: None
                        width: '44dp'
                        on_press: app.af_set_bottom_here()
                FieldRow:
                    PanelLabel:
                        text: 'Top (um)'
                        size_hint_x: 0.45
                    SmallInput:
                        id: af_top_input
                        text: '200'
                    FlatButton:
                        text: 'here'
                        size_hint_x: None
                        width: '44dp'
                        on_press: app.af_set_top_here()
                FieldRow:
                    PanelLabel:
                        text: 'Interval (um)'
                        size_hint_x: 0.45
                    SmallInput:
                        id: af_step_input
                        text: '10'
                FieldRow:
                    FlatButton:
                        text: 'Anchor = here'
                        on_press: app.af_set_anchor_here()
                    FlatButton:
                        text: 'Go to anchor'
                        on_press: app.af_goto_anchor()
                AccentButton:
                    text: 'Run AF cycle (updates surface)'
                    on_press: app.run_af_cycle()

                HeaderLabel:
                    text: 'FOCUS SURFACE'
                FieldRow:
                    FlatButton:
                        text: '+ point here'
                        on_press: app.surface_add_point_here()
                    FlatButton:
                        text: 'Clear'
                        on_press: app.surface_clear_points()
                FlatButton:
                    text: 'Z -> surface here'
                    on_press: app.surface_goto_here_z()

                HeaderLabel:
                    text: 'SHADING CORRECTION'
                FlatButton:
                    text: 'Capture reference (selected ch)'
                    on_press: app.capture_shading_reference()

                HeaderLabel:
                    text: 'TILE SCAN'
                FieldRow:
                    PanelLabel:
                        text: 'Rows'
                        size_hint_x: 0.3
                    SmallInput:
                        id: tile_rows_input
                        text: '3'
                    PanelLabel:
                        text: 'Cols'
                        size_hint_x: 0.3
                    SmallInput:
                        id: tile_cols_input
                        text: '3'
                FieldRow:
                    PanelLabel:
                        text: 'Overlap (%)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: tile_overlap_input
                        text: '10'
                FieldRow:
                    AccentButton:
                        text: 'Grid scan'
                        on_press: app.run_tile_scan('grid')
                    AccentButton:
                        text: 'Spiral scan'
                        on_press: app.run_tile_scan('spiral')

                HeaderLabel:
                    text: 'IMAGE SCALE'
                FieldRow:
                    PanelLabel:
                        text: 'um / pixel (bin 1)'
                        size_hint_x: 0.55
                    SmallInput:
                        id: um_per_px_input
                        text: str(app.base_um_per_px)
                        on_text_validate: app.set_um_per_px(self.text)
                FieldRow:
                    FlatButton:
                        text: 'Flip img X'
                        on_press: app.toggle_invert('img_x')
                    FlatButton:
                        text: 'Flip img Y'
                        on_press: app.toggle_invert('img_y')

        # ------------------------- CENTER: image -------------------------
        BoxLayout:
            orientation: 'vertical'
            spacing: '4dp'
            ZoomPanCameraWidget:
                id: main_camera_viewport
                show_crosshair: app.crosshair_on
            Label:
                size_hint_y: None
                height: '18dp'
                text: 'Double-click the image to center that point under the optics'
                color: TXT_DIM
                font_size: '10sp'

        # --------------- RIGHT: plate navigator + stage ---------------
        ScrollView:
            size_hint_x: None
            width: '300dp'
            do_scroll_x: False
            bar_width: '4dp'
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: '4dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: PANEL
                    Rectangle:
                        pos: self.pos
                        size: self.size

                HeaderLabel:
                    text: 'LABWARE'
                DarkSpinner:
                    id: labware_spinner
                    text: app.labware_name
                    values: app.labware_options
                    on_text: app.select_labware(self.text)
                FieldRow:
                    FlatButton:
                        text: 'Duplicate'
                        on_press: app.duplicate_labware()
                    FlatButton:
                        text: 'Edit / New'
                        on_press: app.open_labware_editor()
                    FlatButton:
                        text: 'Delete'
                        on_press: app.delete_labware()

                HeaderLabel:
                    text: 'PLATE NAVIGATOR'
                WellPlateMapWidget:
                    id: plate_map
                    size_hint_y: None
                    height: '200dp'
                FieldRow:
                    PanelLabel:
                        text: 'Selected well: ' + app.selected_well_str
                        size_hint_x: 0.6
                    FlatButton:
                        text: 'Set A1 = here'
                        on_press: app.set_a1_here()
                PanelLabel:
                    text: 'Double-click a well to move the stage there'

                HeaderLabel:
                    text: 'PLATE CALIBRATION'
                PanelLabel:
                    text: app.cal_info
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: '0dp' if app.cal_active else '30dp'
                    opacity: 0 if app.cal_active else 1
                    AccentButton:
                        text: 'Calibrate plate...'
                        disabled: app.cal_active
                        on_press: app.cal_start()
                BoxLayout:
                    orientation: 'vertical'
                    spacing: '3dp'
                    size_hint_y: None
                    height: '126dp' if app.cal_active else '0dp'
                    opacity: 1 if app.cal_active else 0
                    Label:
                        text: app.cal_label
                        color: (1.0, 0.45, 0.35, 1)
                        bold: True
                        font_size: '12sp'
                        size_hint_y: None
                        height: '20dp'
                    PanelLabel:
                        text: 'Center the FOV on the red target, then Mark'
                    AccentButton:
                        text: 'MARK (uses current XY)'
                        disabled: not app.cal_active
                        on_press: app.cal_mark()
                    FieldRow:
                        FlatButton:
                            text: '< Prev'
                            disabled: not app.cal_active
                            on_press: app.cal_prev()
                        FlatButton:
                            text: 'Next >'
                            disabled: not app.cal_active
                            on_press: app.cal_next()
                    FieldRow:
                        FlatButton:
                            text: 'Finish'
                            disabled: not app.cal_active
                            on_press: app.cal_finish()
                        StopButton:
                            text: 'Cancel'
                            disabled: not app.cal_active
                            on_press: app.cal_cancel()
                FlatButton:
                    text: 'Save measured geometry as labware copy'
                    on_press: app.cal_save_measured_labware()
                FieldRow:
                    FlatButton:
                        text: 'Flip plate X'
                        on_press: app.toggle_invert('plate_x')
                    FlatButton:
                        text: 'Flip plate Y'
                        on_press: app.toggle_invert('plate_y')

                HeaderLabel:
                    text: 'STAGE'
                Label:
                    text: app.stage_coord_str
                    color: TXT
                    font_size: '13sp'
                    bold: True
                    size_hint_y: None
                    height: '22dp'
                GridLayout:
                    cols: 3
                    spacing: '3dp'
                    size_hint_y: None
                    height: '96dp'
                    Widget:
                    FlatButton:
                        text: 'Y +'
                        on_press: app.jog('Y', 1000)
                    Widget:
                    FlatButton:
                        text: 'X -'
                        on_press: app.jog('X', -1000)
                    FlatButton:
                        text: 'Center'
                        on_press: app.goto_center()
                    FlatButton:
                        text: 'X +'
                        on_press: app.jog('X', 1000)
                    Widget:
                    FlatButton:
                        text: 'Y -'
                        on_press: app.jog('Y', -1000)
                    Widget:
                GridLayout:
                    cols: 4
                    spacing: '3dp'
                    size_hint_y: None
                    height: '62dp'
                    FlatButton:
                        text: 'Z +100'
                        on_press: app.jog('Z', 100)
                    FlatButton:
                        text: 'Z +10'
                        on_press: app.jog('Z', 10)
                    FlatButton:
                        text: 'Z -10'
                        on_press: app.jog('Z', -10)
                    FlatButton:
                        text: 'Z -100'
                        on_press: app.jog('Z', -100)
                    FlatButton:
                        text: 'XY -5k'
                        on_press: app.jog('X', -5000); app.jog('Y', -5000)
                    FlatButton:
                        text: 'Z +1k'
                        on_press: app.jog('Z', 1000)
                    FlatButton:
                        text: 'Z -1k'
                        on_press: app.jog('Z', -1000)
                    FlatButton:
                        text: 'Re-home'
                        on_press: app.rehome()

                HeaderLabel:
                    text: 'FOCUS SURFACE STATUS'
                Label:
                    text: app.surface_info
                    color: TXT_DIM
                    font_size: '10sp'
                    size_hint_y: None
                    height: '40dp'
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'top'

    # ============================= STATUS BAR =============================
    BoxLayout:
        size_hint_y: None
        height: '24dp'
        padding: '8dp', '2dp'
        canvas.before:
            Color:
                rgba: PANEL
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: app.status_msg
            color: (1.0, 0.75, 0.2, 1) if app.worker_busy else TXT
            font_size: '12sp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size
