#:kivy 2.3.0

<LumaViewProMainLayout>:
    orientation: 'vertical'
    padding: ('8dp', 0)
    spacing: '6dp'

    # Header Bar
    BoxLayout:
        size_hint_y: None
        height: '42dp'
        spacing: '10dp'
        canvas.before:
            Color:
                rgba: 0.12, 0.14, 0.18, 1.0
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LumaViewPro Microscope Control System"
            font_size: '18sp'
            bold: True
            color: 0.2, 0.8, 1.0, 1.0
            size_hint_x: 0.40
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: app.status_msg
            font_size: '13sp'
            color: 0.8, 0.8, 0.2, 1.0
            size_hint_x: 0.25
            halign: 'center'
            valign: 'middle'

        Label:
            text: app.stage_coord_str
            font_size: '14sp'
            color: 0.9, 0.9, 0.9, 1.0
            size_hint_x: 0.35
            halign: 'right'
            valign: 'middle'
            text_size: self.size

    # Main Center Split: Camera Viewport (Left) + Control Panel (Right)
    BoxLayout:
        orientation: 'horizontal'
        spacing: '8dp'

        # Live Camera Viewport
        ZoomPanCameraWidget:
            id: main_camera_viewport
            size_hint_x: 0.62

        # Right Control Panel
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.38
            spacing: '6dp'

            # Plate Navigator Canvas Map
            InteractiveScaledPlateCanvas:
                id: main_plate_canvas
                size_hint_y: 0.42

            # Hardware & Method Protocol Control Deck
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.58
                spacing: '4dp'
                padding: '6dp'
                canvas.before:
                    Color:
                        rgba: 0.15, 0.17, 0.22, 1.0
                    Rectangle:
                        pos: self.pos
                        size: self.size

                # Section 1: Camera Stream & LED Controls
                Label:
                    text: "Camera Stream & Illumination Controls"
                    font_size: '14sp'
                    bold: True
                    size_hint_y: None
                    height: '20dp'
                    color: 0.3, 0.8, 1.0, 1.0

                # Exposure Slider
                BoxLayout:
                    size_hint_y: None
                    height: '28dp'
                    spacing: '6dp'
                    Label:
                        text: "Exposure (ms): " + str(round(app.camera_exposure_ms, 1))
                        size_hint_x: 0.40
                        font_size: '12sp'
                    Slider:
                        min: 0.1
                        max: 200.0
                        value: app.camera_exposure_ms
                        on_value: app.set_camera_exposure(self.value)
                        size_hint_x: 0.60

                # LED Power Slider
                BoxLayout:
                    size_hint_y: None
                    height: '28dp'
                    spacing: '6dp'
                    Label:
                        text: "LED Power (%): " + str(int(app.led_power_pct))
                        size_hint_x: 0.40
                        font_size: '12sp'
                    Slider:
                        min: 0
                        max: 100
                        value: app.led_power_pct
                        on_value: app.set_led_power(self.value)
                        size_hint_x: 0.60

                # Camera Auto Control Buttons & Stream Test
                GridLayout:
                    cols: 4
                    spacing: '3dp'
                    size_hint_y: None
                    height: '30dp'
                    Button:
                        text: 'Auto Gain'
                        on_press: app.toggle_auto_gain()
                    Button:
                        text: 'Auto Exp'
                        on_press: app.toggle_auto_exposure()
                    Button:
                        text: 'Auto Focus'
                        on_press: app.run_autofocus()
                    Button:
                        text: 'Stream Test'
                        on_press: app.run_hardware_stream_diagnostic()

                # Section 2: Optical Channels
                Label:
                    text: "Optical Illumination Channels"
                    font_size: '14sp'
                    bold: True
                    size_hint_y: None
                    height: '20dp'
                    color: 0.3, 0.8, 1.0, 1.0

                GridLayout:
                    cols: 4
                    spacing: '3dp'
                    size_hint_y: None
                    height: '56dp'
                    Button:
                        text: 'Brightfield'
                        on_press: app.set_active_channel('BF')
                    Button:
                        text: 'Phase (PC)'
                        on_press: app.set_active_channel('PC')
                    Button:
                        text: 'Darkfield (DF)'
                        on_press: app.set_active_channel('DF')
                    Button:
                        text: 'Blue (470)'
                        on_press: app.set_active_channel('BLUE')
                    Button:
                        text: 'Green (530)'
                        on_press: app.set_active_channel('GREEN')
                    Button:
                        text: 'Red (625)'
                        on_press: app.set_active_channel('RED')
                    Button:
                        text: 'Violet (405)'
                        on_press: app.set_active_channel('VIOLET')
                    Button:
                        text: 'LEDs Off'
                        on_press: app.turn_off_all_leds()

                # Section 3: Focus Map & Protocol Steps
                Label:
                    text: "Focus Map & Protocol Steps"
                    font_size: '14sp'
                    bold: True
                    size_hint_y: None
                    height: '20dp'
                    color: 0.3, 0.8, 1.0, 1.0

                GridLayout:
                    cols: 2
                    spacing: '4dp'
                    size_hint_y: None
                    height: '32dp'
                    Button:
                        text: '+ Add Focus Map Point'
                        on_press: app.add_current_focus_map_point()
                    Button:
                        text: '+ Add AF Step Point'
                        on_press: app.add_current_autofocus_point()

                # Section 4: Stage Jog Controls
                GridLayout:
                    cols: 3
                    spacing: '4dp'
                    size_hint_y: None
                    height: '70dp'

                    Widget:
                    Button:
                        text: 'Y+ (Up)'
                        on_press: app.jog_stage(0, 1)
                    Widget:

                    Button:
                        text: 'X- (Left)'
                        on_press: app.jog_stage(-1, 0)
                    Button:
                        text: 'Home Stage'
                        on_press: app.home_stage_and_synchronize()
                    Button:
                        text: 'X+ (Right)'
                        on_press: app.jog_stage(1, 0)

                    Widget:
                    Button:
                        text: 'Y- (Down)'
                        on_press: app.jog_stage(0, -1)
                    Widget:
