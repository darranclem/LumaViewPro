#:kivy 2.0.0

<ZoomPanCameraWidget>:
    # Canvas viewport rendering is handled dynamically in Python (redraw_viewport)
    Widget:


<PlateNavigatorPopup>:
    title: "LumaViewPro - Plate Navigator & Registration Studio"
    size_hint: 0.96, 0.96
    content: popup_root_box

    BoxLayout:
        id: popup_root_box
        orientation: 'vertical'
        spacing: '8dp'
        padding: '8dp'

        # Plate Format Selection Bar inside Navigator Studio Header
        BoxLayout:
            size_hint_y: None
            height: '32dp'
            spacing: '10dp'
            padding: ['4dp', '2dp']
            canvas.before:
                Color:
                    rgba: 0.14, 0.16, 0.22, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Select Microplate Layout Format:"
                size_hint_x: 0.35
                font_size: '11sp'
                bold: True
                color: (0.3, 0.8, 1.0, 1)

            Spinner:
                text: "96-Well Plate"
                values: ["6-Well Plate", "12-Well Plate", "24-Well Plate", "48-Well Plate", "96-Well Plate", "384-Well Plate"]
                size_hint_x: 0.35
                font_size: '11sp'
                bold: True
                on_text: app.set_well_plate_format(self.text)

            Label:
                text: "Double-Click Well = Jump Stage | Single-Click = Select FOV"
                size_hint_x: 0.30
                font_size: '10sp'
                color: (0.8, 0.8, 0.8, 1)

        TabbedPanel:
            id: main_tabbed_panel
            do_default_tab: False
            tab_width: '180dp'

            # TAB 1: Calibration & Interactive Template Screen
            TabbedPanelItem:
                text: '1. Calibration'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: '8dp'
                    padding: '8dp'

                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: '10dp'

                        # Left Column: Interactive Scaled Microplate Canvas
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.48
                            spacing: '5dp'
                            canvas.before:
                                Color:
                                    rgba: 0.12, 0.14, 0.18, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            Label:
                                text: "Microplate Template (A1 Top-Left Orientation)"
                                bold: True
                                font_size: '12sp'
                                size_hint_y: None
                                height: '22dp'
                                color: (0.3, 0.8, 1.0, 1)

                            InteractiveScaledPlateCanvas:
                                id: scaled_canvas_tab1

                            BoxLayout:
                                size_hint_y: None
                                height: '30dp'
                                spacing: '6dp'

                                Button:
                                    text: "Select All"
                                    font_size: '11sp'
                                    on_release: app.fov_manager.select_all_wells(); scaled_canvas_tab1.redraw_canvas()

                                Button:
                                    text: "Clear All"
                                    font_size: '11sp'
                                    on_release: app.fov_manager.clear_all_wells(); scaled_canvas_tab1.redraw_canvas()

                                Button:
                                    text: "Sync Channels"
                                    background_color: (0.2, 0.5, 0.8, 1)
                                    bold: True
                                    font_size: '11sp'
                                    on_release: app.global_sync_active_channels()

                            # Registration Target & Jog
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: '140dp'
                                padding: '6dp'
                                spacing: '4dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.16, 0.16, 0.22, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                Label:
                                    id: wizard_instruction_label
                                    text: "Step 1/6: Jog stage to Well A1 - 12 o'clock position (top rim)"
                                    size_hint_y: None
                                    height: '22dp'
                                    color: (0.9, 0.9, 0.2, 1)
                                    bold: True
                                    font_size: '11sp'

                                GridLayout:
                                    cols: 3
                                    size_hint_y: None
                                    height: '55dp'
                                    spacing: '3dp'
                                    size_hint_x: 0.6
                                    pos_hint: {'center_x': 0.5}

                                    Widget:
                                    Button:
                                        text: "+Y"
                                        font_size: '10sp'
                                        on_release: app.jog_stage(0, 1.0, 0)
                                    Widget:
                                    Button:
                                        text: "-X"
                                        font_size: '10sp'
                                        on_release: app.jog_stage(-1.0, 0, 0)
                                    Button:
                                        text: "Center A1"
                                        font_size: '9sp'
                                        on_release: app.zero_stage()
                                    Button:
                                        text: "+X"
                                        font_size: '10sp'
                                        on_release: app.jog_stage(1.0, 0, 0)
                                    Widget:
                                    Button:
                                        text: "-Y"
                                        font_size: '10sp'
                                        on_release: app.jog_stage(0, -1.0, 0)
                                    Widget:

                                BoxLayout:
                                    size_hint_y: None
                                    height: '28dp'
                                    spacing: '8dp'

                                    Button:
                                        text: "Mark Stage Position"
                                        background_color: (0.2, 0.7, 0.3, 1)
                                        bold: True
                                        font_size: '11sp'
                                        on_release: app.record_calibration_step(); scaled_canvas_tab1.redraw_canvas()

                                    Button:
                                        text: "Finish Calibration"
                                        background_color: (0.8, 0.4, 0.2, 1)
                                        bold: True
                                        font_size: '11sp'
                                        on_release: app.finish_plate_calibration(); scaled_canvas_tab1.redraw_canvas()

                        # Right Column: Interactive Live Camera Viewport & Focus Controls
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.52
                            spacing: '6dp'

                            ZoomPanCameraWidget:
                                id: camera_viewport_tab1
                                size_hint_y: 0.6

                            # Live Feed & Camera Control Dock in Tab 1
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: 0.4
                                spacing: '5dp'
                                padding: '6dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.14, 0.12, 0.18, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                BoxLayout:
                                    size_hint_y: None
                                    height: '26dp'
                                    spacing: '6dp'

                                    ToggleButton:
                                        text: "Light: ON" if app.is_light_on else "Light: OFF"
                                        state: 'down' if app.is_light_on else 'normal'
                                        size_hint_x: 0.4
                                        font_size: '10sp'
                                        bold: True
                                        on_release: app.toggle_light_state()

                                    Label:
                                        text: "Channel:"
                                        size_hint_x: 0.25
                                        font_size: '10sp'

                                    Spinner:
                                        id: calib_channel_spinner
                                        text: "Brightfield"
                                        values: ["Brightfield", "Phase", "Darkfield", "Blue", "Green", "Red"]
                                        size_hint_x: 0.35
                                        font_size: '10sp'
                                        on_text: app.select_channel(self.text)

                                BoxLayout:
                                    size_hint_y: None
                                    height: '26dp'
                                    spacing: '6dp'

                                    Label:
                                        text: "Exp (ms):"
                                        size_hint_x: 0.2
                                        font_size: '10sp'
                                    TextInput:
                                        text: str(app.camera_exposure_ms)
                                        multiline: False
                                        size_hint_x: 0.25
                                        font_size: '10sp'
                                        on_text_validate: app.set_af_exposure(self.text)

                                    Label:
                                        text: "LED Power (%):"
                                        size_hint_x: 0.3
                                        font_size: '10sp'
                                    TextInput:
                                        text: str(app.led_power)
                                        multiline: False
                                        size_hint_x: 0.25
                                        font_size: '10sp'
                                        on_text_validate: app.set_led_power(self.text)

                                Button:
                                    text: "Set Stage Position as Master Auto Point (Red)"
                                    size_hint_y: None
                                    height: '26dp'
                                    background_color: (0.8, 0.2, 0.2, 1)
                                    bold: True
                                    font_size: '10sp'
                                    on_release: app.set_master_auto_point(); scaled_canvas_tab1.redraw_canvas()

                                Button:
                                    text: "Test Autofocus Acquisition Sweep"
                                    size_hint_y: None
                                    height: '26dp'
                                    background_color: (0.2, 0.6, 0.8, 1)
                                    bold: True
                                    font_size: '10sp'
                                    on_release: app.test_autofocus_run()

            # TAB 2: Autofocus Scan Dialogue, Nyquist Calculator & Skip Cycle Controls
            TabbedPanelItem:
                text: '2. AF Dialogue'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: '10dp'
                    padding: '10dp'

                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: '15dp'

                        # Left Column: Camera Viewport with Live Feed Controls
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.45
                            spacing: '5dp'
                            canvas.before:
                                Color:
                                    rgba: 0.1, 0.12, 0.16, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            ZoomPanCameraWidget:
                                id: camera_viewport_tab2
                                size_hint_y: 0.7

                            # Camera & Stage Jog Control Bar in Tab 2
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: 0.3
                                spacing: '4dp'
                                padding: '4dp'

                                BoxLayout:
                                    size_hint_y: None
                                    height: '24dp'
                                    spacing: '4dp'

                                    ToggleButton:
                                        text: "Light: ON" if app.is_light_on else "Light: OFF"
                                        state: 'down' if app.is_light_on else 'normal'
                                        size_hint_x: 0.4
                                        font_size: '10sp'
                                        on_release: app.toggle_light_state()

                                    Spinner:
                                        text: "Brightfield"
                                        values: ["Brightfield", "Phase", "Darkfield", "Blue", "Green", "Red"]
                                        size_hint_x: 0.6
                                        font_size: '10sp'
                                        on_text: app.select_channel(self.text)

                                GridLayout:
                                    cols: 4
                                    size_hint_y: None
                                    height: '26dp'
                                    spacing: '2dp'

                                    Button:
                                        text: "-Y"
                                        font_size: '9sp'
                                        on_release: app.jog_stage(0, -1.0, 0)
                                    Button:
                                        text: "+Y"
                                        font_size: '9sp'
                                        on_release: app.jog_stage(0, 1.0, 0)
                                    Button:
                                        text: "-Z"
                                        font_size: '9sp'
                                        on_release: app.jog_stage(0, 0, -1.0)
                                    Button:
                                        text: "+Z"
                                        font_size: '9sp'
                                        on_release: app.jog_stage(0, 0, 1.0)

                        # Right Column: AF Scan Range, Skip Cycles & Optical Nyquist Calculator
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.55
                            spacing: '8dp'
                            padding: '6dp'

                            Label:
                                text: "Autofocus Search Scan, Skip Cycle & Lens Nyquist Setup"
                                font_size: '13sp'
                                bold: True
                                size_hint_y: None
                                height: '22dp'

                            GridLayout:
                                cols: 2
                                spacing: '6dp'
                                size_hint_y: None
                                height: '55dp'

                                Label:
                                    text: "AF Search Range (+/- um):"
                                    font_size: '11sp'
                                TextInput:
                                    id: af_range_input
                                    text: "50.0"
                                    multiline: False
                                    font_size: '11sp'
                                    on_text_validate: app.set_af_search_range(self.text)

                                Label:
                                    text: "AF Step Size (um):"
                                    font_size: '11sp'
                                TextInput:
                                    id: af_step_input
                                    text: "2.0"
                                    multiline: False
                                    font_size: '11sp'

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: '4dp'
                                padding: '4dp'
                                size_hint_y: None
                                height: '85dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.16, 0.14, 0.22, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                Label:
                                    text: "Autofocus Cycle Skip & Time-Lapse Schedule"
                                    bold: True
                                    color: (0.9, 0.7, 1.0, 1)
                                    font_size: '11sp'

                                BoxLayout:
                                    spacing: '6dp'

                                    Label:
                                        text: "AF Frequency:"
                                        size_hint_x: 0.4
                                        font_size: '10sp'

                                    Spinner:
                                        id: af_cycle_spinner
                                        text: "Every Cycle (1)"
                                        values: ["Every Cycle (1)", "Every 2nd Cycle (2)", "Every 3rd Cycle (3)", "Every 5th Cycle (5)", "Every 10th Cycle (10)"]
                                        size_hint_x: 0.6
                                        font_size: '10sp'
                                        on_text: app.set_af_cycle_interval(self.text)

                                BoxLayout:
                                    spacing: '6dp'

                                    CheckBox:
                                        id: timelapse_enable_checkbox
                                        active: False
                                        size_hint_x: None
                                        width: '25dp'
                                        on_active: app.set_time_lapse_config(self.active, tl_interval_input.text, tl_cycles_input.text)

                                    Label:
                                        text: "Time-Lapse (m):"
                                        size_hint_x: 0.35
                                        font_size: '10sp'

                                    TextInput:
                                        id: tl_interval_input
                                        text: "10.0"
                                        multiline: False
                                        size_hint_x: 0.2
                                        font_size: '10sp'
                                        on_text_validate: app.set_time_lapse_config(timelapse_enable_checkbox.active, self.text, tl_cycles_input.text)

                                    Label:
                                        text: "Cycles:"
                                        size_hint_x: 0.25
                                        font_size: '10sp'

                                    TextInput:
                                        id: tl_cycles_input
                                        text: "24"
                                        multiline: False
                                        size_hint_x: 0.2
                                        font_size: '10sp'
                                        on_text_validate: app.set_time_lapse_config(timelapse_enable_checkbox.active, tl_interval_input.text, self.text)

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: '4dp'
                                padding: '4dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.12, 0.16, 0.22, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                Label:
                                    text: "Optical Lens Specifications & Nyquist Calculator"
                                    bold: True
                                    color: (0.4, 0.8, 1.0, 1)
                                    font_size: '11sp'

                                GridLayout:
                                    cols: 4
                                    spacing: '3dp'

                                    Label:
                                        text: "NA:"
                                        font_size: '10sp'
                                    TextInput:
                                        text: "0.45"
                                        multiline: False
                                        font_size: '10sp'

                                    Label:
                                        text: "Mag:"
                                        font_size: '10sp'
                                    TextInput:
                                        text: "20.0"
                                        multiline: False
                                        font_size: '10sp'

                                    Label:
                                        text: "Wavelength:"
                                        font_size: '10sp'
                                    TextInput:
                                        text: "525.0"
                                        multiline: False
                                        font_size: '10sp'

                                    Label:
                                        text: "Immersion n:"
                                        font_size: '10sp'
                                    TextInput:
                                        text: "1.0"
                                        multiline: False
                                        font_size: '10sp'

                                Button:
                                    text: "Calculate & Apply Nyquist Z-Step to AF Config"
                                    size_hint_y: None
                                    height: '28dp'
                                    background_color: (0.2, 0.6, 0.8, 1)
                                    bold: True
                                    font_size: '10sp'
                                    on_release: app.apply_nyquist_calculation()

                            Button:
                                text: "Return to 1. Calibration to Test Autofocus"
                                size_hint_y: None
                                height: '32dp'
                                background_color: (0.2, 0.7, 0.4, 1)
                                bold: True
                                font_size: '11sp'
                                on_release: main_tabbed_panel.switch_to(main_tabbed_panel.tab_list[2])

            # TAB 3: Hardware Protocol, 12x12 Tiling & Chromatic Shift Correction
            TabbedPanelItem:
                text: '3. Hardware Protocol'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: '10dp'
                    padding: '10dp'

                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: '10dp'
                        size_hint_y: 0.85

                        # Left Column: Camera Viewport for Secondary Chromatic Focus Tuning
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.45
                            spacing: '5dp'
                            canvas.before:
                                Color:
                                    rgba: 0.1, 0.12, 0.16, 1
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                            ZoomPanCameraWidget:
                                id: camera_viewport_tab3
                                size_hint_y: 0.7

                            # Camera & Jog Controls in Tab 3
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: 0.3
                                spacing: '3dp'
                                padding: '3dp'

                                BoxLayout:
                                    size_hint_y: None
                                    height: '24dp'
                                    spacing: '4dp'

                                    ToggleButton:
                                        text: "Light: ON" if app.is_light_on else "Light: OFF"
                                        state: 'down' if app.is_light_on else 'normal'
                                        size_hint_x: 0.4
                                        font_size: '10sp'
                                        on_release: app.toggle_light_state()

                                    Spinner:
                                        text: "Brightfield"
                                        values: ["Brightfield", "Phase", "Darkfield", "Blue", "Green", "Red"]
                                        size_hint_x: 0.6
                                        font_size: '10sp'
                                        on_text: app.select_channel(self.text)

                                GridLayout:
                                    cols: 4
                                    size_hint_y: None
                                    height: '26dp'
                                    spacing: '2dp'

                                    Button:
                                        text: "-1.0 um"
                                        font_size: '9sp'
                                        on_release: app.jog_z_stage(-1.0)
                                    Button:
                                        text: "-0.2 um"
                                        font_size: '9sp'
                                        on_release: app.jog_z_stage(-0.2)
                                    Button:
                                        text: "+0.2 um"
                                        font_size: '9sp'
                                        on_release: app.jog_z_stage(0.2)
                                    Button:
                                        text: "+1.0 um"
                                        font_size: '9sp'
                                        on_release: app.jog_z_stage(1.0)

                        # Right Column: Tiling, Channel Accept/Reject & Secondary Chromatic Offsets
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.55
                            spacing: '8dp'

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: '4dp'
                                padding: '6dp'
                                size_hint_y: None
                                height: '65dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.12, 0.15, 0.2, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                Label:
                                    text: "Tiled Area Grid Dimensions (1x1 up to 12x12)"
                                    bold: True
                                    font_size: '11sp'

                                BoxLayout:
                                    spacing: '6dp'

                                    Label:
                                        text: "Rows:"
                                        size_hint_x: 0.2
                                        font_size: '10sp'
                                    TextInput:
                                        id: tile_rows_tab3
                                        text: "1"
                                        multiline: False
                                        size_hint_x: 0.25
                                        font_size: '10sp'

                                    Label:
                                        text: "Cols:"
                                        size_hint_x: 0.2
                                        font_size: '10sp'
                                    TextInput:
                                        id: tile_cols_tab3
                                        text: "1"
                                        multiline: False
                                        size_hint_x: 0.25
                                        font_size: '10sp'

                                    Button:
                                        text: "Apply Grid"
                                        size_hint_x: 0.3
                                        font_size: '10sp'
                                        on_release: app.apply_grid_settings(tile_rows_tab3.text, tile_cols_tab3.text, True)

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: '4dp'
                                padding: '6dp'
                                size_hint_y: None
                                height: '65dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.15, 0.12, 0.2, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                Label:
                                    text: "Per-Channel Chromatic Z-Offset Correction"
                                    bold: True
                                    color: (0.8, 0.6, 1.0, 1)
                                    font_size: '11sp'

                                BoxLayout:
                                    spacing: '6dp'

                                    Spinner:
                                        id: chromatic_channel_spinner
                                        text: "Blue"
                                        values: ["Brightfield", "Phase", "Darkfield", "Blue", "Green", "Red"]
                                        size_hint_x: 0.5
                                        font_size: '10sp'

                                    Button:
                                        text: "Save Z as Channel Offset"
                                        size_hint_x: 0.5
                                        background_color: (0.6, 0.3, 0.8, 1)
                                        bold: True
                                        font_size: '10sp'
                                        on_release: app.set_chromatic_z_offset(chromatic_channel_spinner.text)

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: '4dp'
                                padding: '6dp'
                                size_hint_y: None
                                height: '65dp'
                                canvas.before:
                                    Color:
                                        rgba: 0.12, 0.12, 0.14, 1
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                                Label:
                                    text: "Accept / Reject Channels for Execution"
                                    bold: True
                                    size_hint_y: None
                                    height: '20dp'
                                    font_size: '11sp'

                                GridLayout:
                                    cols: 3
                                    spacing: '4dp'

                                    BoxLayout:
                                        CheckBox:
                                            active: True
                                            on_active: app.focus_map.accepted_channels["Brightfield"] = self.active
                                        Label:
                                            text: "BF"
                                            font_size: '10sp'
                                    BoxLayout:
                                        CheckBox:
                                            active: True
                                            on_active: app.focus_map.accepted_channels["Phase"] = self.active
                                        Label:
                                            text: "Phase"
                                            font_size: '10sp'
                                    BoxLayout:
                                        CheckBox:
                                            active: True
                                            on_active: app.focus_map.accepted_channels["Darkfield"] = self.active
                                        Label:
                                            text: "DF"
                                            font_size: '10sp'
                                    BoxLayout:
                                        CheckBox:
                                            active: True
                                            on_active: app.focus_map.accepted_channels["Blue"] = self.active
                                        Label:
                                            text: "Blue"
                                            font_size: '10sp'
                                    BoxLayout:
                                        CheckBox:
                                            active: True
                                            on_active: app.focus_map.accepted_channels["Green"] = self.active
                                        Label:
                                            text: "Green"
                                            font_size: '10sp'
                                    BoxLayout:
                                        CheckBox:
                                            active: True
                                            on_active: app.focus_map.accepted_channels["Red"] = self.active
                                        Label:
                                            text: "Red"
                                            font_size: '10sp'

                    Button:
                        text: "Apply Protocol to Experiment Execution Engine & Save"
                        size_hint_y: None
                        height: '42dp'
                        background_color: (0.2, 0.7, 0.4, 1)
                        bold: True
                        font_size: '13sp'
                        on_release: app.generate_and_apply_protocol(); root.dismiss()
